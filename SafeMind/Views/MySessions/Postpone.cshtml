@model SafeMind.Models.SessionsViewModel

<link rel="stylesheet" href="~/css/book-session.css" asp-append-version="true" />

@{
    var oldSessionId = (int)ViewBag.PostponeSessionId;
}

<div class="appointment-page">

    <div class="flow-header">
        <p class="eyebrow">Reschedule</p>
        <h1>Pick a new time</h1>
        <p class="subhead">Choose a new session time with Dr. @Model.DoctorName. Your current session will be cancelled automatically.</p>
    </div>

    <form asp-action="ConfirmPostpone" asp-controller="MySessions" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="oldSessionId" value="@oldSessionId" />
        <input type="hidden" name="doctorId" value="@Model.DoctorId" />
        <input type="hidden" id="selectedSlotsJson" name="selectedSlotsJson" />

        <div class="header-row">
            <div class="card">
                <div class="doc-header">
                    <div class="avatar"></div>
                    <div class="doc-meta">
                        <h1>Dr. @Model.DoctorName</h1>

                        <div class="pill-row">
                            @foreach (var s in Model.Specialties)
                            {
                                <span class="pill">@s</span>
                            }
                            @if (Model.Languages.Any())
                            {
                                <span class="pill">@string.Join(" / ", Model.Languages)</span>
                            }
                        </div>

                        <div class="stats">
                            <span class="stat-pill">$@Model.Price / session</span>
                            <span class="stat-pill">@Model.SessionDuration min</span>
                            <span class="stat-pill">@Model.AvailabilityRange</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card calendar-card">
                <div class="calendar-head">
                    <p class="calendar-title" id="weekTitle">This Week</p>
                    <div class="cal-nav">
                        <button type="button" class="cal-btn" id="prevWeek">Prev</button>
                        <button type="button" class="cal-btn" id="nextWeek">Next</button>
                    </div>
                </div>
                <div class="calendar-wrap">
                    <div class="week-grid" id="weekGrid"></div>
                </div>
            </div>
        </div>

        <div class="card sessions">
            <div class="sessions-head">
                <div>
                    <h3>Available sessions</h3>
                    <small id="selectedDateLabel" data-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">@Model.SelectedDate.ToString("dddd, MMM d")</small>
                </div>
                <div class="text-muted">Pick one new time slot</div>
            </div>

            <div class="session-grid" id="sessionGrid">
                @foreach (var slot in Model.AvailableSlots)
                {
                    <div class="session">
                        <strong>@slot</strong>
                        <small>@Model.SessionDuration min · Online / In-person</small>
                        <span class="cta">Select</span>
                    </div>
                }
            </div>

            <div class="empty-state" id="sessionEmpty"
                 style="display:@(Model.AvailableSlots.Any() ? "none" : "block")">
                No sessions for this day. Try another date.
            </div>

            <div class="continue-actions" id="continueContainer">
                <button type="submit" class="continue-btn" id="continueBtn">
                    Confirm reschedule
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/book-appointment.js" asp-append-version="true"></script>
    <script>
        // Limit selection to 1 slot for postpone
        document.addEventListener('DOMContentLoaded', () => {
            if (window._safeSlotLimit === undefined) {
                window._safeSlotLimit = 1;
            }
        });
    </script>
}
