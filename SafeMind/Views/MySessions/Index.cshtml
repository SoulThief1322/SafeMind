@using Data.Enums
@model SafeMind.Models.MySessionsPageViewModel
<link rel="stylesheet" href="~/css/mysessions.css" asp-append-version="true" />
<script src="~/js/mysessions.js" asp-append-version="true" defer></script>

@{
    var isDoctor = User.IsInRole("Doctor");
}

<section class="my-sessions container py-4">
    <div class="sessions-header">
        <div>
            <p class="eyebrow">Overview</p>
            <h1 class="sessions-title">My Sessions</h1>
            <p class="sessions-sub">Quick snapshot of what’s booked.</p>
        </div>
        <div class="pill-switch" id="sessionTabs">
            <button class="pill active" type="button" data-target="upcoming">Upcoming</button>
            <button class="pill" type="button" data-target="past">Past</button>
        </div>
    </div>

    @if (!isDoctor)
    {
    <div class="credits-card">
        <div class="credits-header">
            <div>
                <p class="eyebrow">Schedule status</p>
                <h2 class="h5 mb-0">@Model.Upcoming.Count session@(Model.Upcoming.Count == 1 ? string.Empty : "s")
                    upcoming</h2>
                    <p class="sessions-sub">@Model.PaidCount paid · @Model.ProgressPercent% complete</p>
                </div>
            </div>
            <div class="progress">
                <div class="progress-fill" style="width: @Model.ProgressPercent%"></div>
            </div>
        </div>
    }

    @if (!isDoctor)
    {
        <div class="section-block" data-panel="upcoming">
            <div class="section-head">
                <p class="eyebrow">Payment due</p>
                <h2 class="h5 mb-0">@Model.Unpaid.Count awaiting payment</h2>
            </div>
            <div class="session-list">
                @if (!Model.Unpaid.Any())
                {
                    <div class="empty-state">No unpaid sessions. You're all set.</div>
                }
                else
                {
                    foreach (var s in Model.Unpaid)
                    {
                        var unpaidSessionDt = s.SessionDate.ToDateTime(s.SessionTime);
                        var unpaidCanModify = unpaidSessionDt > DateTime.UtcNow.AddHours(24) && s.SessionStatus != SessionStatus.Cancelled;
                        <article class="session-card">
                            <div class="date-bar date-accent"></div>
                            <div class="session-content">
                                <div class="session-main">
                                    <div>
                                        <p class="eyebrow">@s.SessionDate.ToString("ddd, MMM d") · @s.SessionTime.ToString("hh\\:mm")</p>
                                        <h3 class="session-title">Session (@s.SessionDuration min)</h3>
                                        <p class="session-with">With Dr. @s.DoctorName</p>
                                    </div>
                                    <div class="session-actions">
                                        <span class="chip chip-due">Payment due</span>
                                        @if (unpaidCanModify)
                                        {
                                            <a href="@Url.Action("Postpone", "MySessions", new { id = s.SessionId })" class="btn-ghost">Postpone</a>
                                            <form asp-action="Cancel" asp-controller="MySessions" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.SessionId" />
                                                <button type="submit" class="btn-danger">Cancel</button>
                                            </form>
                                        }
                                        <button onclick="location.href='@Url.Action("Payment", "MySessions", new { id = s.SessionId })'" class="btn-primary-solid">Pay now</button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    }

            <div class="section-block" data-panel="upcoming">
                <div class="section-head">
                    <p class="eyebrow">Upcoming sessions</p>
                    <h2 class="h5 mb-0">Nearest first</h2>
                </div>
                <div class="session-list">
                    @if (!Model.Upcoming.Any())
                    {
                        <div class="empty-state">No sessions booked yet.</div>
                    }
                    else
                    {
                        foreach (var s in Model.Upcoming)
                        {
                            var isPaid = s.PaymentStatus == PaymentStatus.Paid;
                            var isScheduled = s.SessionStatus == SessionStatus.Scheduled;
                            var sessionDt = s.SessionDate.ToDateTime(s.SessionTime);
                            var canModify = sessionDt > DateTime.UtcNow.AddHours(24) && s.SessionStatus != SessionStatus.Cancelled;
                            <article class="session-card">
                                <div class="date-bar @(isPaid ? "date-primary" : "date-accent")"></div>
                                <div class="session-content">
                                    <div class="session-main">
                                        <div>
                                            <p class="eyebrow">@s.SessionDate.ToString("ddd, MMM d") · @s.SessionTime.ToString("hh\\:mm")</p>
                                            <h3 class="session-title">Session (@s.SessionDuration min)</h3>
                                            @if (isDoctor)
                                            {
                                                <p class="session-with">@(!string.IsNullOrEmpty(s.ContactFullName) ? $"With {s.ContactFullName}" : "Patient")</p>
                                            }
                                            else
                                            {
                                                <p class="session-with">With Dr. @s.DoctorName</p>
                                            }
                                            </div>
                                            <div class="session-actions">
                                                @if (isDoctor)
                                                {
                                                    <span class="chip @(s.SessionStatus == SessionStatus.Confirmed ? "chip-paid" : "chip-neutral")">@s.SessionStatus</span>
                                                    @if (isScheduled)
                                                    {
                                                        <form asp-action="Confirm" asp-controller="MySessions" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@s.SessionId" />
                                                            <button type="submit" class="btn-primary-solid">Confirm</button>
                                                        </form>
                                                    }
                                                    @if (canModify)
                                                    {
                                                        <a href="@Url.Action("Postpone", "MySessions", new { id = s.SessionId })" class="btn-ghost">Postpone</a>
                                                        <form asp-action="Cancel" asp-controller="MySessions" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@s.SessionId" />
                                                            <button type="submit" class="btn-danger">Cancel</button>
                                                        </form>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (isPaid)
                                                    {
                                                        <span class="chip chip-paid">Paid</span>
                                                        @if (canModify)
                                                        {
                                                            <a href="@Url.Action("Postpone", "MySessions", new { id = s.SessionId })" class="btn-ghost">Postpone</a>
                                                            <form asp-action="Cancel" asp-controller="MySessions" method="post" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@s.SessionId" />
                                                                <button type="submit" class="btn-danger">Cancel</button>
                                                            </form>
                                                        }
                                                        <button class="btn-primary-ghost" type="button">Join session</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="chip chip-due">Payment due</span>
                                                        @if (canModify)
                                                        {
                                                            <a href="@Url.Action("Postpone", "MySessions", new { id = s.SessionId })" class="btn-ghost">Postpone</a>
                                                            <form asp-action="Cancel" asp-controller="MySessions" method="post" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@s.SessionId" />
                                                                <button type="submit" class="btn-danger">Cancel</button>
                                                            </form>
                                                        }
                                                        <button onclick="location.href='@Url.Action("Payment", "MySessions", new { id = s.SessionId })'" class="btn-primary-solid">Pay now</button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>

                <div class="section-block" data-panel="past" style="display:none;">
                    <div class="section-head">
                        <p class="eyebrow">Past sessions</p>
                    </div>
                    <div class="session-list">
                        @if (!Model.Past.Any())
                        {
                            <div class="empty-state">No past sessions to show.</div>
                        }
                        else
                        {
                            foreach (var s in Model.Past)
                            {
                                var isScheduledPast = s.SessionStatus == SessionStatus.Scheduled;
                                var canComplete = s.SessionStatus != SessionStatus.Completed && s.SessionStatus != SessionStatus.Cancelled;
                                <article class="session-card">
                                    <div class="date-bar date-primary"></div>
                                    <div class="session-content">
                                        <div class="session-main">
                                            <div>
                                                <p class="eyebrow">@s.SessionDate.ToString("ddd, MMM d") · @s.SessionTime.ToString("hh\\:mm")</p>
                                                <h3 class="session-title">Session (@s.SessionDuration min)</h3>
                                                @if (isDoctor)
                                                {
                                                    <p class="session-with">@(!string.IsNullOrEmpty(s.ContactFullName) ? $"With {s.ContactFullName}" : "Patient")</p>
                                                }
                                                else
                                                {
                                                    <p class="session-with">With Dr. @s.DoctorName</p>
                                                }
                                            </div>
                                            <div class="session-actions">
                                                @if (isDoctor)
                                                {
                                                    <span class="chip @(s.SessionStatus == SessionStatus.Confirmed ? "chip-paid" : "chip-neutral")">@s.SessionStatus</span>
                                                    @if (isScheduledPast)
                                                    {
                                                        <form asp-action="Confirm" asp-controller="MySessions" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@s.SessionId" />
                                                            <button type="submit" class="btn-primary-solid">Confirm</button>
                                                        </form>
                                                    }
                                                        @if (canComplete)
                                                        {
                                                            <form asp-action="Complete" asp-controller="MySessions" method="post" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@s.SessionId" />
                                                                <button type="submit" class="btn-ghost">Mark completed</button>
                                                            </form>
                                                        }
                                                }
                                                else
                                                {
                                                    <span class="chip chip-neutral">@s.SessionStatus</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>
                </section>