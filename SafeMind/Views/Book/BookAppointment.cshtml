@model SafeMind.Models.AppointmentViewModel
@{
	ViewData["Title"] = "Book Appointment";
}

<link rel="stylesheet" href="~/css/book-appointment.css" asp-append-version="true" />
<style>
	.continue-actions {
		display: none;
		margin-top: 1rem;
		justify-content: flex-end;
	}

	.continue-btn {
		padding: 0.85rem 1.4rem;
		border-radius: 12px;
		border: 1px solid var(--color-primary);
		background: var(--color-primary);
		color: #ffffff;
		font-weight: 600;
		cursor: pointer;
		transition: box-shadow 0.15s ease, transform 0.1s ease;
	}

	.continue-btn:hover {
		box-shadow: 0 12px 30px rgba(46, 111, 84, 0.25);
	}

	.continue-btn:active {
		transform: translateY(1px);
	}
</style>

<div class="appointment-page">
	<div class="header-row">
		<div class="card">
			<div class="doc-header">
				<div class="avatar" aria-hidden="true"></div>
				<div class="doc-meta">
					<h1>Dr. @Model.DoctorName</h1>
					<div class="pill-row">
						@foreach (var s in Model.Specialties)
						{
							<span class="pill">@s</span>
						}
						@if (Model.Languages.Any())
						{
							<span class="pill">@string.Join(" / ", Model.Languages)</span>
						}
					</div>
					<p class="bio">
						@Model.Biography
					</p>
					<div class="stats">
						<span class="stat-pill">Rating @Model.Rating</span>
						<span class="stat-pill">$@Model.Price / session</span>
						<span class="stat-pill">@Model.SessionDuration min</span>
						<span class="stat-pill">@Model.AvailabilityRange</span>
					</div>
				</div>
			</div>
		</div>

		<div class="card calendar-card">
			<div class="calendar-head">
				<p class="calendar-title" id="weekTitle">This Week</p>
				<div class="cal-nav">
					<button class="cal-btn" id="prevWeek">Prev</button>
					<button class="cal-btn" id="nextWeek">Next</button>
				</div>
			</div>
			<div class="calendar-wrap">
				<div class="week-grid" id="weekGrid"></div>
			</div>
		</div>
	</div>

	<div class="card sessions">
		<div class="sessions-head">
			<div>
				<h3>Available sessions</h3>
				<small id="selectedDateLabel" class="text-muted">@Model.SelectedDate.ToString("dddd, MMM d")</small>
			</div>
			<div class="text-muted">Times shown in 24-hour format</div>
		</div>
		<div class="session-grid" id="sessionGrid">
			@foreach (var slot in Model.AvailableSlots)
			{
				<div class="session">
					<strong>@slot</strong>
					<small>@Model.SessionDuration min · Online / In-person</small>
					<span class="cta">Select</span>
				</div>
			}
		</div>
		<div class="empty-state" id="sessionEmpty" style="display:@(Model.AvailableSlots.Any() ? "none" : "block")">No sessions for this day. Try another date.</div>
		<div class="continue-actions" id="continueContainer">
			<button type="button" class="continue-btn" id="continueBtn">Continue to book appointment</button>
		</div>
	</div>
</div>

@section Scripts {
<script>
(function () {
	const weekGrid = document.getElementById('weekGrid');
	const weekTitle = document.getElementById('weekTitle');
	const prevWeekBtn = document.getElementById('prevWeek');
	const nextWeekBtn = document.getElementById('nextWeek');
	const sessionGrid = document.getElementById('sessionGrid');
	const sessionEmpty = document.getElementById('sessionEmpty');
	const selectedDateLabel = document.getElementById('selectedDateLabel');
	const doctorId = @Model.DoctorId;
	const selectedSlotsByDate = new Map();
	const continueContainer = document.getElementById('continueContainer');

	const today = new Date();
	const currentWeekStart = startOfWeek(today);
	const initialSelectedDate = new Date('@Model.SelectedDate.ToString("yyyy-MM-dd")');
	let selectedDate = toIso(initialSelectedDate);
	let weekStart = startOfWeek(initialSelectedDate);

	const baseSlots = ["09:00", "10:30", "12:00", "14:00", "16:00", "18:00"];
	const sampleFullDays = [1, 2, 3]; // Mon, Tue, Wed richer availability

	function startOfWeek(date) {
		const d = new Date(date);
		const day = d.getDay(); // 0=Sun
		const diff = d.getDate() - day + 1; // start Monday
		d.setDate(diff);
		d.setHours(0,0,0,0);
		return d;
	}

	function formatDateLabel(date) {
		return date.toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' });
	}

	function formatWeekLabel(start) {
		const startNormalized = startOfWeek(start);
		if (startNormalized.getTime() === currentWeekStart.getTime()) {
			return 'This Week';
		}
		const end = new Date(startNormalized);
		end.setDate(end.getDate() + 6);
		const opts = { month: 'short', day: 'numeric' };
		return `${startNormalized.toLocaleDateString(undefined, opts)} - ${end.toLocaleDateString(undefined, opts)}`;
	}

	function renderWeek() {
		weekGrid.innerHTML = '';
		weekTitle.textContent = formatWeekLabel(weekStart);

		for (let i = 0; i < 7; i++) {
			const date = new Date(weekStart);
			date.setDate(weekStart.getDate() + i);
			const isPast = date < new Date(today.getFullYear(), today.getMonth(), today.getDate());
			const iso = toIso(date);

			const dayEl = document.createElement('button');
			dayEl.type = 'button';
			dayEl.className = 'day' + (isPast ? ' disabled' : '');
			if (selectedDate === iso) dayEl.classList.add('selected');

			dayEl.innerHTML = `
				<span class="dow">${date.toLocaleDateString(undefined, { weekday: 'short' })}</span>
				<span class="date">${date.getDate()}</span>
			`;

			if (!isPast) {
				dayEl.addEventListener('click', () => {
					selectedDate = iso;
					selectedDateLabel.textContent = formatDateLabel(date);
					renderWeek();
					fetchSessions(iso);
				});
			}

			weekGrid.appendChild(dayEl);
		}

		const minWeek = currentWeekStart.getTime();
		prevWeekBtn.disabled = weekStart.getTime() <= minWeek;
		centerSelectedDay();
	}

	function fetchSessions(isoDate) {
		sessionGrid.innerHTML = '';
		sessionEmpty.style.display = 'none';

		fetch(`/Book/AvailableSessions?id=${doctorId}&date=${isoDate}`)
			.then(r => r.ok ? r.json() : Promise.reject())
			.then(data => {
				if (!data || !Array.isArray(data.slots)) {
					throw new Error('No data');
				}
				if (data.slots.length === 0) {
					sessionEmpty.style.display = 'block';
					sessionEmpty.textContent = 'No sessions for this day. Try another date.';
					return;
				}
				const selectedSet = ensureSelectedSet(isoDate);
				data.slots.forEach(time => {
					const sessionEl = document.createElement('div');
					sessionEl.className = 'session' + (selectedSet.has(time) ? ' selected' : '');
					sessionEl.innerHTML = `
						<strong>${time}</strong>
						<small>@Model.SessionDuration min · Online / In-person</small>
						<span class="cta">Select</span>
					`;
					sessionEl.addEventListener('click', () => toggleSelection(sessionEl, isoDate, time));
					sessionGrid.appendChild(sessionEl);
				});
				updateContinueCta();
			})
			.catch(() => {
				sessionEmpty.style.display = 'block';
				sessionEmpty.textContent = 'Could not load sessions. Please try again.';
			});
	}

	prevWeekBtn.addEventListener('click', () => {
		if (prevWeekBtn.disabled) return;
		weekStart.setDate(weekStart.getDate() - 7);
		renderWeek();
	});

	nextWeekBtn.addEventListener('click', () => {
		weekStart.setDate(weekStart.getDate() + 7);
		renderWeek();
	});

	renderWeek();
	if (selectedDate) {
		fetchSessions(selectedDate);
	}

	function toIso(d) {
		const copy = new Date(d);
		copy.setHours(0,0,0,0);
		return copy.toISOString().slice(0,10);
	}

	function centerSelectedDay() {
		const selected = weekGrid.querySelector('.selected');
		if (!selected) return;
		selected.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
	}

	function ensureSelectedSet(isoDate) {
		let set = selectedSlotsByDate.get(isoDate);
		if (!set) {
			set = new Set();
			selectedSlotsByDate.set(isoDate, set);
		}
		return set;
	}

	function toggleSelection(sessionEl, isoDate, time) {
		const selectedSet = ensureSelectedSet(isoDate);
		const isSelected = sessionEl.classList.contains('selected');
		if (isSelected) {
			selectedSet.delete(time);
			sessionEl.classList.remove('selected');
		} else {
			selectedSet.add(time);
			sessionEl.classList.add('selected');
		}
		updateContinueCta();
	}

	(function wireInitialSessions() {
		const isoDate = selectedDate;
		const selectedSet = ensureSelectedSet(isoDate);
		const nodes = Array.from(sessionGrid.querySelectorAll('.session'));
		nodes.forEach(node => {
			const timeEl = node.querySelector('strong');
			if (!timeEl) return;
			const time = timeEl.textContent?.trim();
			if (!time) return;
			if (selectedSet.has(time)) {
				node.classList.add('selected');
			}
			node.addEventListener('click', () => toggleSelection(node, isoDate, time));
		});
		updateContinueCta();
	})();

	function totalSelectedCount() {
		let total = 0;
		selectedSlotsByDate.forEach(set => total += set.size);
		return total;
	}

	function updateContinueCta() {
		if (!continueContainer) return;
		continueContainer.style.display = totalSelectedCount() > 0 ? 'flex' : 'none';
	}
})();
</script>
}
