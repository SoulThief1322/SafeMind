@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<link rel="stylesheet" href="~/css/booking-flow.css" asp-append-version="true" />

<style>
    .payment-options {
        margin: 0.5rem 0 1rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8faf9;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .payment-option {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
    }

    .payment-option strong {
        color: var(--text);
    }

    .payment-option p {
        margin: 0.15rem 0 0;
        color: var(--muted);
        font-size: 0.95rem;
    }

    .alert-error {
        border: 1px solid #f1c3be;
        background: #fff2f0;
        color: #8a1c1c;
        padding: 0.9rem 1rem;
        border-radius: 10px;
        margin-bottom: 0.75rem;
        font-weight: 600;
    }
</style>

<div class="checkout-page">
    <div class="checkout-header">
        <p class="eyebrow">Step 2 of 2</p>
        <h1>Confirm your booking</h1>
        <p class="subhead">Review the session details and share how we can reach you.</p>
    </div>

    <div class="checkout-grid">
        <section class="card summary-card">
            <div class="card-header">
                <div>
                    <p class="eyebrow">Doctor</p>
                    <h3>Dr. @Model.DoctorName</h3>
                </div>
                <div class="pill">@Model.SessionDuration mins</div>
            </div>

            <div class="price-row">
                <span>Session price</span>
                <span class="price">$@Model.SessionPrice.ToString("0.##")</span>
            </div>

            <div class="slots">
                <p class="eyebrow">Selected sessions (@Model.Slots.Count)</p>
                <ul>
                    @foreach (var s in Model.Slots)
                    {
                        <li>
                            <span class="date">@s.Date.ToString("ddd, MMM d")</span>
                            <span class="time">@s.Time.ToString("hh\\:mm")</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="total-row">
                <div>
                    <p class="label">Total</p>
                    <p class="hint">Billed after your session is confirmed.</p>
                </div>
                <div class="total">$@Model.TotalPrice.ToString("0.##")</div>
            </div>

            <div class="note">
                <span class="dot"></span>
                <p>Rescheduling and cancellations are available up to 48 hours before the session.</p>
            </div>
        </section>

        <section class="card form-card">
            <h3>Your details</h3>
            <p class="hint">We’ll use this to confirm your booking and send reminders.</p>

            <form asp-action="Confirm" method="post" class="checkout-form">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="DoctorId" />

                @for (int i = 0; i < Model.Slots.Count; i++)
                {
                    <input type="hidden" name="Slots[@i].Date" value="@Model.Slots[i].Date" />
                    <input type="hidden" name="Slots[@i].Time" value="@Model.Slots[i].Time" />
                }


                <div class="field">
                    <label asp-for="FullName">Full name</label>
                    <input asp-for="FullName" placeholder="Your full name" />
                    <span asp-validation-for="FullName" class="validation"></span>
                </div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="name@email.com" />
                    <span asp-validation-for="Email" class="validation"></span>
                </div>

                <div class="field">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" placeholder="Include country code" />
                    <span asp-validation-for="PhoneNumber" class="validation"></span>
                </div>

                <div class="field">
                    <label>Payment preference</label>
                    <div class="payment-options">
                        <label class="payment-option" for="pay-now">
                            <input id="pay-now" type="radio" asp-for="PaymentStatus" value="Paid" checked />
                            <div>
                                <strong>Pay now</strong>
                                <p>We’ll process the payment right away and confirm your booking.</p>
                            </div>
                        </label>
                        <label class="payment-option" for="pay-later">
                            <input id="pay-later" type="radio" asp-for="PaymentStatus" value="Pending" />
                            <div>
                                <strong>Pay later</strong>
                                <p>Your booking is created with payment pending; we’ll collect it later.</p>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="PaymentStatus" class="validation"></span>
                </div>

                <div class="actions">
                    <a asp-controller="Book" asp-action="BookAppointment" asp-route-id="@Model.DoctorId" class="btn ghost">Back</a>
                    <button type="submit" class="btn primary">Confirm booking</button>
                </div>
            </form>
        </section>
    </div>
</div>