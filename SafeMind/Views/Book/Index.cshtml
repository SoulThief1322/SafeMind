@using System.Linq
@model SafeMind.Models.BookPageViewModel

<link rel="stylesheet" href="~/css/book.css" asp-append-version="true" />
<style>
    .results-empty {
        padding: 1rem;
        border: 1px dashed #d5d5d5;
        border-radius: 12px;
        text-align: center;
        color: #6b7280;
        background: #fafafa;
    }
</style>

<div class="booking-page">
    <div class="booking-grid">

        <!-- LEFT -->
        <section class="booking-left">
            <h1 class="booking-title">
                Find a professional and book an online appointment
            </h1>
            <p class="muted">
                Search by specialty or name, then pick a time that works for you.
            </p>

            <form id="searchForm" class="booking-form" method="get">
                <div class="form-group">
                    <label>Find professional</label>
                    <div class="field-row">
                        <select id="specialtySelect" class="select" name="specialty">
                            <option value="">Choose specialty</option>
                            @foreach (var specialty in Model.Specialties)
                            {
                                if (string.Equals(Model.SelectedSpecialty, specialty, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@specialty" selected="selected">@specialty</option>
                                }
                                else
                                {
                                    <option value="@specialty">@specialty</option>
                                }
                            }
                        </select>

                        <input class="input"
                               name="name"
                               value="@Model.SearchName"
                               type="search"
                               placeholder="Name (optional)" />
                    </div>
                </div>

                <div class="actions">
                    <button class="primary-btn" type="submit">Search</button>
                </div>

                <div class="filters">
                    <small class="muted">Quick filters</small>
                    <div class="chip-row">
                        <button class="chip" type="button">Insurance accepted</button>
                        <button class="chip" type="button">Online</button>
                        <button class="chip" type="button">In-person</button>
                        <button class="chip" type="button">Available today</button>
                        <button class="chip" type="button">New clients</button>
                    </div>
                </div>
            </form>

            <div class="popular">
                <small class="muted">Popular specialties</small>
                <div class="popular-row">
                    <button class="popular-chip" type="button" data-specialty="Addiction Medicine">Addiction Medicine</button>
                    <button class="popular-chip" type="button" data-specialty="Behavioral Therapy">Behavioral Therapy</button>
                    <button class="popular-chip" type="button" data-specialty="Neurology">Neurology</button>
                </div>
            </div>
        </section>

        <!-- RIGHT -->
        <section class="booking-right">
            <div class="results-header">
                <div>
                    <h5>Results</h5>
                    <small class="muted">
                        Design-only results to show layout and hierarchy.
                    </small>
                </div>

                <div class="sort-row">
                    <small class="muted">Sort</small>
                    <select class="select select-small">
                        <option>Most relevant</option>
                        <option>Earliest availability</option>
                        <option>Highest rated</option>
                    </select>
                </div>
            </div>

            <div class="results-list">
                @if (Model?.Doctors?.Any() == true)
                {
                    foreach (var doctor in Model.Doctors)
                    {
                        var specialties = string.Join(", ", doctor.Specialties ?? Enumerable.Empty<string>());
                        var languages = string.Join(", ", doctor.Languages ?? Enumerable.Empty<string>());
                        <div class="provider-card">
                            <div class="provider-inner">
                                <div class="avatar" aria-hidden="true"></div>

                                <div class="provider-info">
                                    <h6>
                                        Dr. @doctor.Name
                                        <span class="verified">Verified</span>
                                    </h6>
                                    <p class="muted small">
                                        @specialties@if(!string.IsNullOrWhiteSpace(languages)){ @($" | {languages}") }
                                    </p>
                                    <p class="muted small">
                                        Availability: <strong>@doctor.AvailabilityRange</strong>
                                    </p>
                                </div>

                                <div class="provider-actions">
                                    <div class="price">$@doctor.Price</div>
                                    <div class="muted small">@doctor.SessionDuration min session</div>
                                       <a class="book-btn" href="@Url.Action(action: "BookAppointment", "Book", new { id = doctor.Id })">Book</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="results-empty">
                        <h6>No professionals found</h6>
                        <p class="muted small">Adjust filters or add doctors in the admin area.</p>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Doctor results pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, specialty = Model.SelectedSpecialty, name = Model.SearchName })">Previous</a>
                    }
                    else
                    {
                        <span class="page-link disabled">Previous</span>
                    }

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        var isCurrent = i == Model.PageNumber;
                        if (isCurrent)
                        {
                            <span class="page-link active">@i</span>
                        }
                        else
                        {
                            <a class="page-link" href="@Url.Action("Index", new { page = i, specialty = Model.SelectedSpecialty, name = Model.SearchName })">@i</a>
                        }
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, specialty = Model.SelectedSpecialty, name = Model.SearchName })">Next</a>
                    }
                    else
                    {
                        <span class="page-link disabled">Next</span>
                    }
                </nav>
            }
        </section>

    </div>
</div>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('searchForm');
    const specialtySelect = document.getElementById('specialtySelect');

    document.querySelectorAll('.chip, .popular-chip').forEach(btn => {
        btn.addEventListener('click', () => btn.classList.toggle('active'));
    });

    document.querySelectorAll('.book-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.add('active');
            setTimeout(() => btn.classList.remove('active'), 300);
        });
    });

    document.querySelectorAll('.popular-chip').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetSpecialty = btn.getAttribute('data-specialty');
            if (!targetSpecialty || !specialtySelect) return;

            const match = Array.from(specialtySelect.options)
                .find(opt => opt.text.localeCompare(targetSpecialty, undefined, { sensitivity: 'accent' }) === 0);

            if (match) {
                match.selected = true;
                if (form) {
                    form.submit();
                }
            }
        });
    });
})();
</script>
}
