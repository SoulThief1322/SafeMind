@model SafeMind.Models.SessionsViewModel

<link rel="stylesheet" href="~/css/book-session.css" asp-append-version="true" />

<div class="bs-page">

    <div class="bs-flow-header">
        <p class="bs-eyebrow">Step 1 of 2</p>
        <h1>Select your sessions</h1>
        <p class="bs-subhead">Pick a date and time with Dr. @Model.Doctor.Name before continuing to checkout.</p>
    </div>

    <!-- Doctor card -->
    <div class="bs-doctor-card">
        <div class="bs-avatar"></div>
        <div class="bs-doc-info">
            <h2>Dr. @Model.Doctor.Name</h2>
            <div class="bs-pill-row">
                @foreach (var s in Model.Doctor.Specialties)
                {
                    <span class="bs-pill">@s</span>
                }
                @if (Model.Doctor.Languages.Any())
                {
                    <span class="bs-pill">@string.Join(" / ", Model.Doctor.Languages)</span>
                }
            </div>
            <p class="bs-bio">@Model.Doctor.Biography</p>
            <div class="bs-stats">
                <span class="bs-stat">⭐ @Model.Doctor.Rating</span>
                <span class="bs-stat">$@Model.Doctor.Price / session</span>
                <span class="bs-stat">@Model.Doctor.SessionDuration min</span>
                <span class="bs-stat">@Model.Doctor.AvailabilityRange</span>
            </div>
        </div>
    </div>

    <!-- Booking form -->
    <form asp-action="Checkout" asp-controller="Book" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="doctorId" value="@Model.Doctor.Id" />
        <input type="hidden" id="selectedSlotsJson" name="selectedSlotsJson" />
        <span id="selectedDateLabel" data-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" style="display:none"></span>

        <div class="bs-booking-panel">

            <!-- Left: Month calendar -->
            <div class="bs-calendar">
                <div class="bs-cal-header">
                    <span class="bs-month-title" id="monthTitle"></span>
                    <div class="bs-cal-nav">
                        <button type="button" class="bs-nav-btn" id="prevMonth">&#8249;</button>
                        <button type="button" class="bs-nav-btn" id="nextMonth">&#8250;</button>
                    </div>
                </div>
                <div class="bs-dow-row">
                    <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
                </div>
                <div class="bs-cal-grid" id="calGrid"></div>
            </div>

            <!-- Right: Time slots -->
            <div class="bs-times">
                <div class="bs-times-header">
                    <span class="bs-day-name" id="selectedDayName">Select a date</span>
                    <div class="bs-format-toggle">
                        <button type="button" class="bs-fmt-btn bs-fmt-active" id="fmt12">12h</button>
                        <button type="button" class="bs-fmt-btn" id="fmt24">24h</button>
                    </div>
                </div>
                <div class="bs-slot-grid" id="sessionGrid"></div>
                <div class="bs-empty-state" id="sessionEmpty">No sessions available for this day. Try another date.</div>
            </div>

        </div>

        <div class="bs-continue-row" id="continueContainer">
            <button type="submit" class="bs-continue-btn">Continue to checkout &rarr;</button>
        </div>
    </form>

    <!-- Sticky ghost bar — visible only when real button is scrolled out of view -->
    <div class="bs-sticky-bar" id="stickyBar">
        <span class="bs-sticky-label" id="stickyLabel"></span>
        <button type="button" class="bs-sticky-btn" id="stickyBtn">Continue to checkout &rarr;</button>
    </div>

</div>

@section Scripts {
    <script src="~/js/book-appointment.js" asp-append-version="true"></script>
}
