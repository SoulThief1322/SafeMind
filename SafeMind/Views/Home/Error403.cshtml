@model SafeMind.Models.ErrorViewModel
@{
    ViewData["Title"] = "Access Denied";
}

@section Styles {
    <link rel="stylesheet" href="~/css/error-pages.css" asp-append-version="true" />
}

<div class="error-page">
    <div class="error-card">
        <div class="error-icon error-icon--403">
            <i class="fas fa-lock"></i>
        </div>
        <div class="error-code">403</div>
        <h1 class="error-title">Access Denied</h1>
        <p class="error-message">
            You don't have permission to access this page.
            If you believe this is an error, please contact support.
        </p>
        <div class="error-actions">
            <a href="/" class="error-btn error-btn--primary">
                <i class="fas fa-home"></i> Go Home
            </a>
            <a href="/Contact" class="error-btn error-btn--ghost">
                <i class="fas fa-envelope"></i> Contact Us
            </a>
        </div>
    </div>
</div>
