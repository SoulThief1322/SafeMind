@{
    ViewData["Title"] = "Crisis Resources";
}

<section class="sp-hero">
    <div class="container">
        <h1>Crisis Resources</h1>
        <p>Immediate help is available 24/7. You are not alone.</p>
    </div>
</section>

<section class="sp-body container">

    <div class="crisis-emergency-banner">
        <i class="fas fa-exclamation-triangle"></i>
        <div>
            <strong>If you or someone you know is in immediate danger, call 911 or go to your nearest emergency room.</strong>
            <p>SafeMind is not a crisis intervention service. The resources below connect you with trained crisis counselors around the clock.</p>
        </div>
    </div>

    <h2>US Crisis Hotlines &amp; Text Lines</h2>

    <div class="crisis-grid">

        <div class="crisis-card">
            <h3>988 Suicide &amp; Crisis Lifeline</h3>
            <div class="crisis-contact">Call or Text 988</div>
            <p>Free, confidential support for people in distress and prevention resources for you or your loved ones. Available 24/7.</p>
            <a class="crisis-link" href="https://988lifeline.org/" target="_blank" rel="noopener noreferrer">
                Visit 988lifeline.org <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="crisis-card">
            <h3>Crisis Text Line</h3>
            <div class="crisis-contact">Text HOME to 741741</div>
            <p>Free, 24/7 text-based mental health support. Connect with a trained crisis counselor by texting from anywhere in the US.</p>
            <a class="crisis-link" href="https://www.crisistextline.org/" target="_blank" rel="noopener noreferrer">
                Visit crisistextline.org <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="crisis-card">
            <h3>SAMHSA National Helpline</h3>
            <div class="crisis-contact">1-800-662-4357</div>
            <p>Free, confidential, 24/7 treatment referral and information service for individuals and families facing mental health or substance use disorders.</p>
            <a class="crisis-link" href="https://www.samhsa.gov/find-help/national-helpline" target="_blank" rel="noopener noreferrer">
                Visit SAMHSA <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="crisis-card">
            <h3>NAMI Helpline</h3>
            <div class="crisis-contact">1-800-950-6264</div>
            <p>The National Alliance on Mental Illness helpline provides information, referrals, and support to people living with mental illness and their families. M–F 10am–10pm ET.</p>
            <a class="crisis-link" href="https://www.nami.org/Support-Education/NAMI-HelpLine" target="_blank" rel="noopener noreferrer">
                Visit NAMI <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="crisis-card">
            <h3>Veterans Crisis Line</h3>
            <div class="crisis-contact">Call 988, Press 1</div>
            <p>Specialized support for veterans, service members, and their families. Also available by text (838255) and live chat.</p>
            <a class="crisis-link" href="https://www.veteranscrisisline.net/" target="_blank" rel="noopener noreferrer">
                Visit VeteransCrisisLine.net <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

        <div class="crisis-card">
            <h3>The Trevor Project</h3>
            <div class="crisis-contact">1-866-488-7386</div>
            <p>Crisis intervention and suicide prevention for LGBTQ+ young people under 25. Available 24/7 by phone, text (text START to 678-678), and chat.</p>
            <a class="crisis-link" href="https://www.thetrevorproject.org/" target="_blank" rel="noopener noreferrer">
                Visit TheTrevorProject.org <i class="fas fa-external-link-alt"></i>
            </a>
        </div>

    </div>

    <h2>International Resources</h2>
    <ul>
        <li><a href="https://findahelpline.com/" target="_blank" rel="noopener noreferrer">findahelpline.com</a> – A global directory of crisis helplines by country.</li>
        <li><a href="https://www.befrienders.org/" target="_blank" rel="noopener noreferrer">Befrienders Worldwide</a> – Emotional support in over 50 countries.</li>
        <li><a href="https://www.iasp.info/resources/Crisis_Centres/" target="_blank" rel="noopener noreferrer">IASP Crisis Centres</a> – International Association for Suicide Prevention directory.</li>
    </ul>

    <h2>Additional Mental Health Support</h2>
    <ul>
        <li><a href="https://www.mentalhealth.gov/" target="_blank" rel="noopener noreferrer">MentalHealth.gov</a> – US government mental health resources and information.</li>
        <li><a href="https://www.nimh.nih.gov/health/find-help" target="_blank" rel="noopener noreferrer">NIMH – Find Help</a> – National Institute of Mental Health guidance on seeking care.</li>
    </ul>

    <h2>Book a Session on SafeMind</h2>
    <p>If you're not in immediate crisis but would like professional support, our licensed therapists are here to help. <a asp-controller="Book" asp-action="Index">Book a session today.</a></p>

</section>
