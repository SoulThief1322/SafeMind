@model SafeMind.Models.ErrorViewModel
@{
    ViewData["Title"] = "Page Not Found";
}

@section Styles {
    <link rel="stylesheet" href="~/css/error-pages.css" asp-append-version="true" />
}

<div class="error-page">
    <div class="error-card">
        <div class="error-icon error-icon--404">
            <i class="fas fa-map-signs"></i>
        </div>
        <div class="error-code">404</div>
        <h1 class="error-title">Page Not Found</h1>
        <p class="error-message">
            The page you're looking for doesn't exist or has been moved.
            Don't worry — let's get you back on track.
        </p>
        <div class="error-actions">
            <a href="/" class="error-btn error-btn--primary">
                <i class="fas fa-home"></i> Go Home
            </a>
            <a href="/Contact" class="error-btn error-btn--ghost">
                <i class="fas fa-envelope"></i> Contact Us
            </a>
        </div>
    </div>
</div>
