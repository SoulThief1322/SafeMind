@model SafeMind.Models.HomePageViewModel
@{
    string MoodEmoji(string? mood) => mood switch
    {
        "Happy"   => "😊",
        "Excited" => "⚡",
        "Calm"    => "🌿",
        "Anxious" => "😰",
        "Sad"     => "💙",
        "Angry"   => "🌋",
        _         => "📊"
    };
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-content">
        <p class="eyebrow">SafeMind · Mental Health Care</p>
        <h1>Book therapy, track your mood, and learn coping skills.</h1>
        <p class="hero-subtitle">Evidence-based support from licensed professionals, guided tools you can use anytime, and a calm space to check in with yourself.</p>
        <div class="hero-actions">
            <a href="/Book" class="cta-button">Book a session</a>
            <a href="/Articles" class="secondary-link">Browse resources</a>
        </div>
    </div>
    <div class="hero-images">
        <div class="image-large">
            <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=640&h=520&fit=crop" alt="Therapist supporting a client">
        </div>
        <div class="image-extra-1">
            <img src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=320&h=320&fit=crop" alt="Notebook and a calming desk scene">
        </div>
        <div class="image-small">
            <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=360&h=360&fit=crop" alt="Person enjoying fresh air in nature">
        </div>
        <div class="image-extra-2">
            <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=300&h=300&fit=crop" alt="Calm workspace with coffee">
        </div>
    </div>
</section>

<!-- FEATURES SECTION -->
<section class="features-section">
    <div class="section-content">
        <h2>Why SafeMind</h2>
        <p class="section-description">A guided place to get professional help, understand your feelings, and build habits that keep you grounded.</p>
    </div>
    <div class="features-grid">
        <article class="feature-card">
            <h3>Therapy that fits you</h3>
            <p>Match with licensed clinicians across CBT, EMDR, family, and couples therapy. Sessions are online and private.</p>
        </article>
        <article class="feature-card">
            <h3>Daily check-ins</h3>
            <p>Lightweight mood and energy check-ins to spot patterns and share context with your therapist.</p>
        </article>
        <article class="feature-card">
            <h3>Actionable tools</h3>
            <p>Short exercises, breathing guides, and evidence-based tips you can use between sessions.</p>
        </article>
    </div>
</section>

<!-- DIVIDER -->
<div class="section-divider"></div>

<!-- MENTAL HEALTH INFO SECTION -->
<section class="mental-health-section">
    <div class="section-content">
        <h2>About mental health</h2>
        <p class="section-description">
            Mental health is about more than the absence of illness — it's how we think, feel, and cope with life's challenges. Taking care of your mind is just as important as caring for your body.
        </p>
    </div>

    <div class="content-grid">
        <div class="content-card">
            <h3>Stress</h3>
            <p>A natural response to pressures, but chronic stress can affect sleep, focus, and mood.</p>
            <a href="/Articles?category=Stress" class="learn-more-btn">Learn more →</a>
        </div>

        <div class="content-card">
            <h3>Anxiety</h3>
            <p>Feelings of worry or fear that can become overwhelming. Learn ways to manage and calm your mind.</p>
            <a href="/Articles?category=Anxiety" class="learn-more-btn">Learn more →</a>
        </div>
    </div>
</section>

<!-- MOOD CHECK SECTION -->
<section class="mood-section" id="moodSection" data-authenticated="@(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false")">
    <div class="mood-aurora"></div>

    <div class="mood-prompt" id="moodPrompt">
        <h2>How are you feeling today?</h2>
        <p class="mood-sub">Take a moment. There's no wrong answer.</p>

        <div class="mood-orbs" id="moodOrbs">
            <button class="mood-orb orb-great" data-mood="Great" aria-label="Feeling great">
                <span class="orb-glow"></span>
                <span class="orb-icon">&#9728;&#65039;</span>
                <span class="orb-label">Great</span>
                <span class="orb-hint">Bright &amp; energised</span>
            </button>
            <button class="mood-orb orb-okay" data-mood="Okay" aria-label="Feeling okay">
                <span class="orb-glow"></span>
                <span class="orb-icon">&#127764;</span>
                <span class="orb-label">Okay</span>
                <span class="orb-hint">Calm &amp; steady</span>
            </button>
            <button class="mood-orb orb-low" data-mood="Not great" aria-label="Not feeling great">
                <span class="orb-glow"></span>
                <span class="orb-icon">&#127783;&#65039;</span>
                <span class="orb-label">Not great</span>
                <span class="orb-hint">Heavy or low</span>
            </button>
        </div>
    </div>

    <div class="mood-dashboard hidden" id="moodDashboard">
        <div class="dash-header">
            <span class="dash-emoji" id="dashEmoji"></span>
            <div>
                <h3 id="dashHeadline"></h3>
                <p class="dash-saved" id="dashSaved">Saved for the next 24 h</p>
            </div>
            <button class="dash-reset" id="dashReset" title="Pick again">&#8635;</button>
        </div>

        <div class="dash-cards">
            <div class="dash-card dash-breathe" id="dashBreathe">
                <span class="dash-card-icon">&#127788;&#65039;</span>
                <h4>3-min breathing</h4>
                <p>Inhale 4 s &middot; Hold 4 s &middot; Exhale 6 s</p>
                <div class="breathe-ring hidden" id="breatheRing">
                    <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="ring-track"/><circle cx="60" cy="60" r="52" class="ring-progress" id="ringProgress"/></svg>
                    <span class="breathe-phase" id="breathePhase">Ready</span>
                </div>
                <button class="dash-card-btn" id="btnBreathe">Start</button>
            </div>

            <div class="dash-card dash-journal">
                <span class="dash-card-icon">&#128221;</span>
                <h4>Quick thought</h4>
                <p id="journalPromptText"></p>
                <a class="dash-card-btn" href="/MyDiary">Open diary</a>
            </div>

            <div class="dash-card dash-tip">
                <span class="dash-card-icon">&#128161;</span>
                <h4>Micro-tip</h4>
                <p id="tipText"></p>
            </div>
        </div>

        <div class="dash-footer">
            <a href="/Book" class="dash-book-btn">Book a session</a>
        </div>
    </div>
</section>

<!-- WELLNESS SNAPSHOT — logged-in users with diary history -->
@if (User.Identity?.IsAuthenticated == true && Model.InsightTotalEntries > 0)
{
    <section class="wellness-snapshot">
        <div class="snapshot-inner">
            <div class="snap-stat">
                <span class="snap-icon">🔥</span>
                <div class="snap-body">
                    <span class="snap-value">@Model.InsightStreak</span>
                    <span class="snap-label">day streak</span>
                </div>
            </div>
            <div class="snap-divider"></div>
            <div class="snap-stat">
                <span class="snap-icon">📊</span>
                <div class="snap-body">
                    <span class="snap-value">@Model.InsightAvgScore.ToString("F1")<span class="snap-denom">/5</span></span>
                    <span class="snap-label">avg mood · 30 days</span>
                </div>
            </div>
            <div class="snap-divider"></div>
            <div class="snap-stat">
                <span class="snap-icon">📝</span>
                <div class="snap-body">
                    <span class="snap-value">@Model.InsightTotalEntries</span>
                    <span class="snap-label">entries this month</span>
                </div>
            </div>
            <div class="snap-divider"></div>
            <div class="snap-stat">
                <span class="snap-icon">@MoodEmoji(Model.InsightDominantMood)</span>
                <div class="snap-body">
                    <span class="snap-value">@Model.InsightDominantMood</span>
                    <span class="snap-label">top mood</span>
                </div>
            </div>
        </div>
        <a href="/MyDiary" class="snap-link">View full diary →</a>
    </section>
}

<!-- RECOMMENDED ARTICLES -->
<section class="recommended-section" id="recommendedSection"
         @(User.Identity?.IsAuthenticated != true ? Html.Raw("style=\"display:none\"") : Html.Raw(""))>
    <div class="rec-header">
        <h2>Recommended for you</h2>
        <p class="rec-subtitle">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.InsightTotalEntries > 0)
                {
                    <text>Based on your mood over the last 30 days</text>
                }
                else
                {
                    <text>A starting point for your wellness journey</text>
                }
            }
            else
            {
                <text>Based on today's mood</text>
            }
        </p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="articles-grid">
            @foreach (var article in Model.RecommendedArticles)
            {
                <article class="article-card">
                    @if (!string.IsNullOrEmpty(article.ImagePath))
                    {
                        <div class="article-image">
                            <img src="@article.ImagePath" alt="@article.Headline">
                        </div>
                    }
                    <div class="article-content">
                        @if (article.ArticleCategories.Any())
                        {
                            <span class="article-tag">@article.ArticleCategories.First().Category.Name</span>
                        }
                        <h3>@article.Headline</h3>
                        <p>@(article.Content.Length > 120 ? article.Content.Substring(0, 120) + "..." : article.Content)</p>
                        <a href="/Articles/SelectedArticle/@article.Id" class="read-more-btn">Read More →</a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="rec-placeholder" id="recPlaceholder">
            <span class="rec-placeholder-icon">✨</span>
            <p>Pick your mood above to see articles matched to how you feel right now.</p>
        </div>
        <div class="articles-grid" id="recGrid" style="display:none"></div>
    }
</section>

<!-- ARTICLES SECTION -->
<section class="articles-section">
    <h2>Mental health articles</h2>
    <div class="articles-grid">
        @foreach (var article in Model.RecentArticles)
        {
            <article class="article-card">
                @if (!string.IsNullOrEmpty(article.ImagePath))
                {
                    <div class="article-image">
                        <img src="@article.ImagePath" alt="@article.Headline">
                    </div>
                }
                <div class="article-content">
                    @if (article.ArticleCategories.Any())
                    {
                        <span class="article-tag">@article.ArticleCategories.First().Category.Name</span>
                    }
                    <h3>@article.Headline</h3>
                    <p>@(article.Content.Length > 120 ? article.Content.Substring(0, 120) + "..." : article.Content)</p>
                    <a href="/Articles/SelectedArticle/@article.Id" class="read-more-btn">Read More →</a>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
<script>
(function () {
    const section = document.getElementById('moodSection');
    const isAuth  = section && section.dataset.authenticated === 'true';

    /* ── Cookie helpers (fallback for guests) ── */
    function setCookie(n, v, h) {
        document.cookie = n + '=' + encodeURIComponent(v) + '; expires=' + new Date(Date.now() + h*36e5).toUTCString() + '; path=/';
    }
    function getCookie(n) {
        return document.cookie.split(';').map(c => c.trim()).filter(c => c.startsWith(n + '=')).map(c => decodeURIComponent(c.split('=')[1]))[0];
    }
    function clearCookie(n) {
        document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    }

    /* ── Server helpers ── */
    function saveMoodServer(mood) {
        return fetch('/Home/SaveMood', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mood: mood })
        });
    }
    function resetMoodServer() {
        return fetch('/Home/ResetMood', { method: 'POST' });
    }
    function getMoodServer() {
        return fetch('/Home/GetMood').then(r => r.json());
    }

    /* ── Elements ── */
    const prompt     = document.getElementById('moodPrompt');
    const dashboard  = document.getElementById('moodDashboard');
    const orbs       = document.querySelectorAll('.mood-orb');
    const dashEmoji  = document.getElementById('dashEmoji');
    const dashHead   = document.getElementById('dashHeadline');
    const journalP   = document.getElementById('journalPromptText');
    const tipP       = document.getElementById('tipText');
    const btnBreathe = document.getElementById('btnBreathe');
    const breatheRing= document.getElementById('breatheRing');
    const ringProg   = document.getElementById('ringProgress');
    const phase      = document.getElementById('breathePhase');
    const resetBtn   = document.getElementById('dashReset');

    /* ── Per-mood content ── */
    const moodData = {
        'Great': {
            emoji: '\u2600\uFE0F',
            headline: 'Brilliant \u2014 let\u2019s bottle this energy.',
            journal: 'What made today shine? Capture a moment of gratitude.',
            tip: 'Share your good energy \u2014 send a kind message to someone you appreciate today.'
        },
        'Okay': {
            emoji: '\uD83C\uDF14',
            headline: 'Steady ground \u2014 a small reset can help.',
            journal: 'What\u2019s one thing you\u2019d like to let go of today?',
            tip: 'Step outside for 2 minutes. Fresh air and a change of scenery reset more than you\u2019d think.'
        },
        'Not great': {
            emoji: '\uD83C\uDF27\uFE0F',
            headline: 'Rough patch \u2014 we\u2019re right here with you.',
            journal: 'No pressure to explain. Even one word about how you feel can help.',
            tip: 'Place a hand on your chest and take 3 slow breaths. You\u2019re safe in this moment.'
        }
    };

    /* ── Show dashboard ── */
    function showDashboard(mood) {
        const d = moodData[mood] || moodData['Okay'];
        dashEmoji.textContent = d.emoji;
        dashHead.textContent  = d.headline;
        journalP.textContent  = d.journal;
        tipP.textContent      = d.tip;

        prompt.classList.add('hidden');
        dashboard.classList.remove('hidden');

        if (!isAuth) loadGuestRecommendations(mood);
    }

    /* ── Guest: fetch recommended articles by today's mood ── */
    function loadGuestRecommendations(mood) {
        const section     = document.getElementById('recommendedSection');
        const grid        = document.getElementById('recGrid');
        const placeholder = document.getElementById('recPlaceholder');
        if (!section || !grid) return;

        section.style.display = '';

        fetch('/Home/GetArticleRecommendations?mood=' + encodeURIComponent(mood))
            .then(function (r) { return r.json(); })
            .then(function (articles) {
                if (!articles.length) return;
                grid.innerHTML = articles.map(function (a) {
                    var img = a.imagePath
                        ? '<div class="article-image"><img src="' + esc(a.imagePath) + '" alt="' + esc(a.headline) + '"></div>'
                        : '';
                    var tag = a.category
                        ? '<span class="article-tag">' + esc(a.category) + '</span>'
                        : '';
                    return '<article class="article-card">'
                        + img
                        + '<div class="article-content">'
                        + tag
                        + '<h3>' + esc(a.headline) + '</h3>'
                        + '<p>' + esc(a.content) + '</p>'
                        + '<a href="/Articles/SelectedArticle/' + a.id + '" class="read-more-btn">Read More \u2192</a>'
                        + '</div></article>';
                }).join('');
                if (placeholder) placeholder.style.display = 'none';
                grid.style.display = '';
            })
            .catch(function () {});
    }

    function esc(str) {
        var d = document.createElement('div');
        d.textContent = str || '';
        return d.innerHTML;
    }

    /* ── Save mood (server or cookie) ── */
    function saveMood(mood) {
        if (isAuth) {
            saveMoodServer(mood);
        } else {
            setCookie('safemindMood', mood, 168); // 7 days so it persists cross-page
        }
    }

    /* ── Orb click ── */
    orbs.forEach(orb => {
        orb.addEventListener('click', () => {
            const mood = orb.dataset.mood;
            orb.classList.add('is-picked');
            prompt.classList.add('is-leaving');
            saveMood(mood);
            setTimeout(() => showDashboard(mood), 480);
        });
    });

    /* ── Reset button ── */
    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            if (isAuth) {
                resetMoodServer();
            } else {
                clearCookie('safemindMood');
                // Hide recommended section and restore placeholder for guests
                const section     = document.getElementById('recommendedSection');
                const grid        = document.getElementById('recGrid');
                const placeholder = document.getElementById('recPlaceholder');
                if (section) section.style.display = 'none';
                if (grid) { grid.innerHTML = ''; grid.style.display = 'none'; }
                if (placeholder) placeholder.style.display = '';
            }
            dashboard.classList.add('hidden');
            prompt.classList.remove('hidden', 'is-leaving');
            orbs.forEach(o => o.classList.remove('is-picked'));
            stopBreathing();
        });
    }

    /* ── Restore saved mood ── */
    if (isAuth) {
        getMoodServer().then(data => {
            if (data && data.mood && moodData[data.mood]) {
                showDashboard(data.mood);
            }
        });
    } else {
        const saved = getCookie('safemindMood');
        if (saved && moodData[saved]) showDashboard(saved);
    }

    /* ── Breathing exercise ── */
    const CIRCUMFERENCE = 327;
    let breatheTimer = null;

    function stopBreathing() {
        clearInterval(breatheTimer);
        breatheTimer = null;
        if (breatheRing) breatheRing.classList.add('hidden');
        if (btnBreathe) { btnBreathe.textContent = 'Start'; btnBreathe.disabled = false; }
        if (ringProg) ringProg.style.strokeDashoffset = CIRCUMFERENCE;
        if (phase) phase.textContent = 'Ready';
    }

    if (btnBreathe) {
        btnBreathe.addEventListener('click', () => {
            if (breatheTimer) { stopBreathing(); return; }

            breatheRing.classList.remove('hidden');
            btnBreathe.textContent = 'Stop';

            const steps = [
                { label: 'Inhale\u2026', dur: 4000 },
                { label: 'Hold\u2026',   dur: 4000 },
                { label: 'Exhale\u2026', dur: 6000 }
            ];
            const total = 180000;
            let stepIdx = 0;
            let stepStart = Date.now();
            const startTime = Date.now();

            function tick() {
                const now = Date.now();
                const elapsed = now - startTime;
                const stepElapsed = now - stepStart;
                const step = steps[stepIdx];

                const pct = Math.min(elapsed / total, 1);
                ringProg.style.strokeDashoffset = CIRCUMFERENCE * (1 - pct);
                phase.textContent = step.label;

                if (stepElapsed >= step.dur) {
                    stepIdx = (stepIdx + 1) % steps.length;
                    stepStart = now;
                }

                if (elapsed >= total) {
                    phase.textContent = 'Done \u2714';
                    btnBreathe.textContent = 'Start';
                    clearInterval(breatheTimer);
                    breatheTimer = null;
                }
            }

            breatheTimer = setInterval(tick, 200);
            tick();
        });
    }
})();
</script>
}

<!-- YOU ARE NOT ALONE SECTION -->
<section class="support-section">
    <h2>You Are Not Alone</h2>
    <p class="support-subtitle">If you're in crisis or feeling overwhelmed, trained professionals are ready to listen 24/7.</p>
    
    <div class="hotline-grid">
        <div class="hotline-card">
            <h4>Sofia Mental Health Hotline</h4>
            <p class="hotline-number">+359 2 920 22 34</p>
        </div>

        <div class="hotline-card">
            <h4>National Suicide Hotline</h4>
            <p class="hotline-number">00359 249 17 223</p>
        </div>

        <div class="hotline-card">
            <h4>Bulgarian Red Cross</h4>
            <p class="hotline-number">0800 11 977</p>
        </div>

        <div class="hotline-card">
            <h4>National Emergency</h4>
            <p class="hotline-number">112</p>
        </div>
    </div>
</section>
