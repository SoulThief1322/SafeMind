@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-content">
        <h1>Healing starts with a single step.</h1>
        <p class="hero-subtitle">Take the first step toward feeling better. Connect with someone who truly understands.</p>
        <a href="#" class="cta-button">Get Help Now</a>
    </div>
    <div class="hero-images">
        <div class="image-large">
            <img src="https://via.placeholder.com/300x250/B7E4C7/2E6F54?text=Mental+Health" alt="Mental health support">
        </div>
        <div class="image-extra-1">
            <img src="https://via.placeholder.com/160x160/CBD5C0/2E6F54?text=Support" alt="Support">
        </div>
        <div class="image-small">
            <img src="https://via.placeholder.com/180x180/CBD5C0/2E6F54?text=Wellness" alt="Wellness">
        </div>
        <div class="image-extra-2">
            <img src="https://via.placeholder.com/140x140/B7E4C7/2E6F54?text=Care" alt="Care">
        </div>
    </div>
</section>

<!-- DIVIDER -->
<div class="section-divider"></div>

<!-- MENTAL HEALTH INFO SECTION -->
<section class="mental-health-section">
    <div class="section-content">
        <h2>About mental health</h2>
        <p class="section-description">
            Mental health is about more than the absence of illness — it's how we think, feel, and cope with life's challenges. Taking care of your mind is just as important as caring for your body.
        </p>
    </div>

    <div class="content-grid">
        <div class="content-card">
            <h3>Stress</h3>
            <p>A natural response to pressures, but chronic stress can affect sleep, focus, and mood.</p>
            <a href="#" class="learn-more-btn">Learn more →</a>
        </div>

        <div class="content-card">
            <h3>Anxiety</h3>
            <p>Feelings of worry or fear that can become overwhelming. Learn ways to manage and calm your mind.</p>
            <a href="#" class="learn-more-btn">Explore →</a>
        </div>
    </div>
</section>

<!-- MOOD CHECK SECTION -->
<section class="mood-section">
    <h2>How are you feeling today?</h2>
    <div class="mood-options">
        <button class="mood-btn mood-great">
            <span class="mood-emoji">😊</span>
            <span class="mood-label">Great</span>
        </button>
        <button class="mood-btn mood-okay">
            <span class="mood-emoji">😐</span>
            <span class="mood-label">Okay</span>
        </button>
        <button class="mood-btn mood-sad">
            <span class="mood-emoji">😟</span>
            <span class="mood-label">Not great</span>
        </button>
    </div>
</section>

<!-- ARTICLES SECTION -->
<section class="articles-section">
    <h2>Mental health articles</h2>
    <div class="articles-grid">
        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1522869635100-ce3402e7fba0?w=400&h=250&fit=crop" alt="Understanding Stress">
            </div>
            <div class="article-content">
                <span class="article-tag">Stress</span>
                <h3>Understanding Stress</h3>
                <p>Learn how stress affects your body and mind, and discover practical techniques to manage it effectively.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=250&fit=crop" alt="Managing Anxiety">
            </div>
            <div class="article-content">
                <span class="article-tag">Anxiety</span>
                <h3>Managing Anxiety</h3>
                <p>Explore evidence-based strategies and daily practices to help reduce anxiety and improve mental well-being.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=250&fit=crop" alt="Building Resilience">
            </div>
            <div class="article-content">
                <span class="article-tag">Resilience</span>
                <h3>Building Resilience</h3>
                <p>Discover how to strengthen your mental resilience and develop coping strategies for life's challenges.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=400&h=250&fit=crop" alt="Sleep and Mental Health">
            </div>
            <div class="article-content">
                <span class="article-tag">Sleep</span>
                <h3>Sleep and Mental Health</h3>
                <p>Understand the crucial connection between quality sleep and mental well-being, plus tips for better rest.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=400&h=250&fit=crop" alt="Mindfulness">
            </div>
            <div class="article-content">
                <span class="article-tag">Mindfulness</span>
                <h3>The Power of Mindfulness</h3>
                <p>Explore mindfulness practices that can help reduce anxiety and improve your overall mental health.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <img src="https://images.unsplash.com/photo-1517457373614-b7152f800fd1?w=400&h=250&fit=crop" alt="Self-Care">
            </div>
            <div class="article-content">
                <span class="article-tag">Self-Care</span>
                <h3>Prioritizing Self-Care</h3>
                <p>Learn why self-care is essential and discover practical ways to incorporate it into your daily routine.</p>
                <a href="#" class="read-more-btn">Read More →</a>
            </div>
        </article>
    </div>
</section>

