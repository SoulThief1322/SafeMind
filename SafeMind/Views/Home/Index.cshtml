@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<!-- HERO SECTION -->
<section class="hero">
    <div class="hero-content">
        <h1>Healing starts with a single step.</h1>
        <p class="hero-subtitle">Take the first step toward feeling better. Connect with someone who truly understands.</p>
        <a href="#" class="cta-button">Get Help Now</a>
    </div>
    <div class="hero-images">
        <div class="image-large">
            <img src="https://via.placeholder.com/300x250/B7E4C7/2E6F54?text=Mental+Health" alt="Mental health support">
        </div>
        <div class="image-extra-1">
            <img src="https://via.placeholder.com/160x160/CBD5C0/2E6F54?text=Support" alt="Support">
        </div>
        <div class="image-small">
            <img src="https://via.placeholder.com/180x180/CBD5C0/2E6F54?text=Wellness" alt="Wellness">
        </div>
        <div class="image-extra-2">
            <img src="https://via.placeholder.com/140x140/B7E4C7/2E6F54?text=Care" alt="Care">
        </div>
    </div>
</section>


