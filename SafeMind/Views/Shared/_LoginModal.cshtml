<div id="loginOverlay" class="overlay hidden" aria-hidden="true"></div>
<div id="loginModal" class="login-modal hidden" role="dialog" aria-modal="true" aria-labelledby="loginTitle" aria-hidden="true">

  <div class="login-content">
    <div class="login-header">
      <div class="login-logo" aria-hidden="true">
        <i class="fas fa-user"></i>
      </div>
      <h2 id="loginTitle">Welcome Back</h2>
      <p>Don't have an account yet? <a href="#" id="switchToRegister" class="signup-link">Sign up</a></p>
    </div>

    <form method="post" asp-area="Identity" asp-page="/Account/Login" class="login-form" aria-label="Login form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

      <div class="login-errors" role="alert" aria-live="polite"></div>

      <div class="form-field">
        <input id="Input_Email" name="Input.Email" type="email" placeholder=" " required autocomplete="email" />
        <label for="Input_Email">Email address</label>
      </div>

      <div class="form-field">
        <input id="Input_Password" name="Input.Password" type="password" placeholder=" " required autocomplete="current-password" />
        <label for="Input_Password">Password</label>
      </div>

      <button type="submit" class="btn-login">Login</button>
    </form>

    <div class="login-separator"><span>OR</span></div>

    <div class="login-logos" aria-hidden="true">
      <a class="logo-btn apple" href="#" title="Apple" aria-label="Apple"><i class="fab fa-apple" aria-hidden="true"></i><span class="sr-only">Apple</span></a>
      <a class="logo-btn google" href="#" title="Google" aria-label="Google"><i class="fab fa-google" aria-hidden="true"></i><span class="sr-only">Google</span></a>
      <a class="logo-btn facebook" href="#" title="Facebook" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i><span class="sr-only">Facebook</span></a>
    </div>


  </div>

  <button id="loginCloseBtn" class="close-btn" aria-label="Close login modal">&times;</button>
</div>