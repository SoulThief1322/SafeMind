<div id="loginOverlay" class="overlay hidden" aria-hidden="true"></div>
<div id="loginModal" class="login-modal hidden" aria-hidden="true" role="dialog">
    <button id="loginCloseBtn" class="close-btn" aria-label="Close login">×</button>

    <div class="login-header">
        <div class="login-logo" aria-hidden="true"><i class="fas fa-user"></i></div>
        <h2>Sign in to your account</h2>
        <p>
            If you prefer, you can also
            <a href="#" id="switchToRegister" class="signup-link">create an account</a>.
        </p>
    </div>

    <div class="login-errors" role="alert" aria-live="polite"></div>

    <form class="login-form" method="post" action="/Identity/Account/Login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <div class="form-field">
            <input name="Input.Email" type="email" placeholder=" " required autocomplete="email" />
            <label>Email address</label>
        </div>

        <div class="form-field">
            <input name="Input.Password" type="password" placeholder=" " required autocomplete="current-password" />
            <label>Password</label>
        </div>

        <button type="submit" class="btn-login">Login</button>
    </form>

    <div class="login-separator"><span>OR</span></div>

    <div class="login-logos" aria-hidden="true">
        <a class="logo-btn apple" href="#" title="Apple" aria-label="Apple"><i class="fab fa-apple" aria-hidden="true"></i><span class="sr-only">Apple</span></a>
        <a class="logo-btn google" href="#" title="Google" aria-label="Google"><i class="fab fa-google" aria-hidden="true"></i><span class="sr-only">Google</span></a>
        <a class="logo-btn facebook" href="#" title="Facebook" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i><span class="sr-only">Facebook</span></a>
    </div>
</div>

<div id="registerOverlay" class="overlay hidden" aria-hidden="true"></div>
<div id="registerModal" class="login-modal hidden" aria-hidden="true" role="dialog">
    <button id="registerCloseBtn" class="close-btn" aria-label="Close register">×</button>

    <div class="login-header">
        <div class="login-logo" aria-hidden="true"><i class="fas fa-user-plus"></i></div>
        <h2>Create a new account</h2>
        <p>
            Already have an account?
            <a href="#" id="switchToLogin" class="signup-link">Sign in</a>
        </p>
    </div>

    <div class="register-errors" role="alert" aria-live="polite"></div>

    <form class="register-form" method="post" action="/Identity/Account/Register">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <div class="form-field">
            <input name="Input.Email" type="email" placeholder=" " required />
            <label>Email address</label>
        </div>

        <div class="form-field">
            <input name="Input.Password" type="password" placeholder=" " required />
            <label>Password</label>
        </div>

        <div class="form-field">
            <input name="Input.ConfirmPassword" type="password" placeholder=" " required />
            <label>Confirm password</label>
        </div>

        <button type="submit" class="btn-login">Register</button>
    </form>

    <div class="login-separator"><span>OR</span></div>

    <div class="login-logos" aria-hidden="true">
        <a class="logo-btn apple" href="#" title="Apple" aria-label="Apple"><i class="fab fa-apple" aria-hidden="true"></i><span class="sr-only">Apple</span></a>
        <a class="logo-btn google" href="#" title="Google" aria-label="Google"><i class="fab fa-google" aria-hidden="true"></i><span class="sr-only">Google</span></a>
        <a class="logo-btn facebook" href="#" title="Facebook" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i><span class="sr-only">Facebook</span></a>
    </div>
</div>