<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMind</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/images/SafeMindLogo.png" />
    <script>document.title = 'SafeMind';</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <div class="page-wrapper">
            <nav class="navbar navbar-custom navbar-expand-lg">
                <div class="container-fluid px-4">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SafeMind</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <div class="nav-links">
                            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            <a asp-area="" asp-controller="Book" asp-action="Index">Book Session</a>
                            <a asp-area="" asp-controller="Articles" asp-action="Index">Articles</a>
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a asp-area="" asp-controller="MySessions" asp-action="Index">My Sessions</a>
                                <a asp-area="" asp-controller="MyDiary" asp-action="Index">My Diary</a>
                            }


                        </div>

                        <div class="nav-actions">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn-sign-in">Sign Out</button>
                                </form>
                            }
                            else
                            {
                                <button id="signInBtn" onclick="window.location.href='/Identity/Account/Login'" class="btn-sign-in">Sign In</button>
                                <button id="signInBtn" onclick="window.location.href='/Identity/Account/RegisterDoctor'" class="btn-sign-in">Register as a doctor</button>

                            }

                            <a href="#" class="btn-cta">Get in touch</a>
                        </div>
                    </div>
                </div>
            </nav>

            <main role="main">
                @RenderBody()
            </main>

            <footer class="footer">
                <div class="footer-container">

                    <div class="footer-section logo-section">
                        <div class="logo-box">
                            <img src="~/images/SafeMindLogo.png" alt="SafeMind logo" class="footer-logo-img"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <span class="logo-text fallback-logo-text" style="display:none">SM</span>
                        </div>

                        <div class="site-name">SafeMind</div>

                        <div class="social-icons">
                            <a href="#"><i class="fab fa-facebook-f"></i></a>
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>

                    <div class="footer-section">
                        <h4>App & Resources</h4>
                        <a href="#">Home</a>
                        <a href="#">Privacy</a>
                        <a href="#">About Us</a>
                        <a href="#">Contact</a>
                    </div>

                    <div class="footer-section">
                        <h4>Support</h4>
                        <a href="#">Mental Health Tips</a>
                        <a href="#">Articles</a>
                        <a href="#">Community</a>
                        <a href="#">FAQs</a>
                    </div>

                    <div class="footer-section">
                        <h4>Site Map</h4>
                        <a href="#">Home</a>
                        <a href="#">Articles</a>
                        <a href="#">Community</a>
                        <a href="#">Privacy Policy</a>
                    </div>
                </div>

                <div class="footer-bottom">
                    &copy; 2025 SafeMind. All rights reserved.
                </div>
            </footer>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/navbar.js"></script>
        <partial name="_AuthModals" />
        <script src="~/js/site.js"></script>
        <script src="/js/login.js" defer></script>
        <script src="/js/register.js" defer></script>

        @await RenderSectionAsync("Scripts", required: false)
</body>

</html>