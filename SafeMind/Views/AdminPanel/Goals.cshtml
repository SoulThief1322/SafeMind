@model List<Data.Models.GoalTemplate>
@{
    ViewData["Title"] = "Admin - Goals";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-layout">
    <partial name="_AdminSidebar" />

    <div class="admin-main">
        <div class="admin-header">
            <div>
                <h1>Goal Templates</h1>
                <p>Manage weekly goal templates assigned to users</p>
            </div>
        </div>

        <div class="admin-card">
            <h2 class="card-title">Add New Goal</h2>
            <form asp-action="AddGoal" method="post" class="goal-add-form">
                @Html.AntiForgeryToken()
                <input type="text" name="description" class="form-input" placeholder="Enter goal description (e.g. Take a 20 minute walk)" maxlength="200" required />
                <button type="submit" class="btn-admin">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Goal
                </button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <h3>No goal templates</h3>
                <p>Add goal templates above — they'll be randomly assigned to users each week.</p>
            </div>
        }
        else
        {
            <div class="admin-card">
                <h2 class="card-title">All Goal Templates (@Model.Count)</h2>
                <div class="goals-list">
                    @foreach (var goal in Model)
                    {
                        <div class="goal-item">
                            <form asp-action="UpdateGoal" method="post" class="goal-edit-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@goal.Id" />
                                <input type="text" name="description" value="@goal.Description" class="form-input goal-input" maxlength="200" required />
                                <button type="submit" class="btn-admin btn-admin-sm" title="Save">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                </button>
                            </form>
                            <form asp-action="DeleteGoal" method="post" onsubmit="return confirm('Delete this goal template?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@goal.Id" />
                                <button type="submit" class="btn-admin btn-admin-sm btn-admin-danger" title="Delete">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
