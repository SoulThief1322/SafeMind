@model SafeMind.Models.DiaryPageViewModel 
@{
	var insights = Model?.Insights;
	var totalEntries = (insights?.TotalJournals ?? 0) + (insights?.TotalCheckIns ?? 0);
	var moodDist = insights?.MoodDistribution ?? new Dictionary<string, int>();
	var moodTotal = moodDist.Values.Sum();
	var avgMood = insights?.AverageMoodScore;
	var streakDays = insights?.DayStreak;
	var hasTodayCheck = Model?.HasTodayCheck ?? false;
	var todayCheck = Model?.CheckIns?.FirstOrDefault(c => c.CreatedOn.ToLocalTime().Date == DateTime.Now.Date);
}

@section Styles {
	<link rel="stylesheet" href="~/css/mydiary.css" asp-append-version="true" />
}
<div class="diary-page">
	<div class="container diary-container">

		<header class="diary-header">
			<div class="diary-title">
				<h1>My Diary</h1>
				<p class="diary-subtitle">A private space to track your day, feelings, and small wins.</p>
			</div>

			<div class="diary-header-actions">
				<button type="button" class="diary-btn diary-btn-primary" onclick="window.location.href = '/MyDiary/NewEntry'" id="newEntryBtn">New entry</button>
				<button type="button" class="diary-btn diary-btn-secondary" id="viewWeekBtn">View week</button>
			</div>
		</header>

		<section class="diary-week" aria-label="This week">
			<div class="diary-week-label" data-week-label>This week</div>
			<div class="diary-week-row" role="list" data-week-row>
			</div>
		</section>

		<section class="card card-soft diary-insights" aria-label="Insights overview">
			<div class="card-head compact">
				<div>
					<h3>Insights</h3>
					<p class="muted">Live snapshot from your journals and check-ins.</p>
				</div>
			</div>

			<div class="insights-layout">
				<div class="insight-visual" aria-live="polite">
					<div class="donut-wrap">
						<div class="donut donut-static">
							<div class="donut-center">
								<div class="donut-total" data-total-entries>@(totalEntries > 0 ? totalEntries.ToString() : "—")</div>
								<div class="donut-label">Total entries</div>
							</div>
						</div>
					</div>
					<div class="donut-legend" data-insights-legend>
						<div class="legend-item">
							<span class="legend-dot" style="background:#F9C74F"></span>
							<div>
								<div>Journals</div>
								<div class="legend-meta">@((insights?.TotalJournals ?? 0)) entries</div>
							</div>
						</div>
						<div class="legend-item">
							<span class="legend-dot" style="background:#90BE6D"></span>
							<div>
								<div>Check-ins</div>
								<div class="legend-meta">@((insights?.TotalCheckIns ?? 0)) entries</div>
							</div>
						</div>
						<div class="legend-item">
							<span class="legend-dot" style="background:#4D908E"></span>
							<div>
								<div>Avg mood</div>
								<div class="legend-meta">@(avgMood.HasValue ? $"{avgMood:0.0} / 5" : "—")</div>
							</div>
						</div>
					</div>
				</div>

				<div class="insight-stack">
					<div class="insight-bars" data-insights-bars>
						@if (moodTotal > 0)
						{
							@foreach (var kv in moodDist.OrderByDescending(k => k.Value))
							{
								var percent = Math.Round((double)kv.Value / moodTotal * 100, 0);
								<div class="bar-row">
									<span class="bar-label">@kv.Key</span>
									<div class="bar-track"><div class="bar-fill" style="width: @percent%"></div></div>
									<span class="bar-value">@percent%</span>
								</div>
							}
						}
						else
						{
							<p class="muted">Mood distribution will appear after you log entries.</p>
						}
					</div>

					<div class="insight-mini">
						<div class="mini-card">
							<div class="mini-label">Streak preview</div>
							<div class="mini-value" data-streak>@(streakDays.HasValue && streakDays > 0 ? $"{streakDays} days" : "—")</div>
							<div class="mini-sub">Keep checking in to grow your streak.</div>
						</div>
				</div>
			</div>
		</section>

			<div class="diary-grid">
				<!-- LEFT: Today's check-in + prompts -->
				<section class="diary-main" aria-label="Today's check-in">
					<form id="checkinForm" method="post" asp-action="SaveCheck" asp-controller="MyDiary">
						@Html.AntiForgeryToken()
					</form>

					@if (hasTodayCheck)
					{
						<div class="card card-hero">
							<div class="card-head">
								<div>
									<h2>Today’s check-in</h2>
									<p class="muted">You already logged a check-in today. Come back tomorrow.</p>
								</div>
							</div>
							<div class="checkin-block">
								<div class="checkin-label">Last entry</div>
								@if (todayCheck != null)
								{
									<p class="muted">
										@todayCheck.CreatedOn.ToLocalTime().ToString("h:mm tt") · Mood: @todayCheck.Mood · Energy: @todayCheck.Energy · Sleep: @todayCheck.Sleep · Stress: @todayCheck.Stress
										@if (!string.IsNullOrWhiteSpace(todayCheck.Notes))
										{
											<br />@todayCheck.Notes
										}
									</p>
								}
								else
								{
									<p class="muted">Saved check-in for today.</p>
								}
							</div>
						</div>
					}
					else
					{
						<div class="card card-hero">
							<div class="card-head">
								<div>
									<h2>Today’s check-in</h2>
									<p class="muted">Quick tap options for how you’re feeling right now.</p>
								</div>
							</div>

							<div class="checkin-block">
								<div class="checkin-label">Mood</div>
								<div class="chip-row" role="list" data-chip-group="mood">
									<button type="button" class="chip" role="listitem" data-value="Happy">Happy</button>
									<button type="button" class="chip" role="listitem" data-value="Calm">Calm</button>
									<button type="button" class="chip" role="listitem" data-value="Excited">Excited</button>
									<button type="button" class="chip chip-active" role="listitem" data-value="Anxious">Anxious</button>
									<button type="button" class="chip" role="listitem" data-value="Sad">Sad</button>
									<button type="button" class="chip" role="listitem" data-value="Angry">Angry</button>
								</div>
							</div>

							<div class="checkin-split">
								<div class="checkin-block">
									<div class="checkin-label">Energy</div>
									<div class="chip-row" role="list" data-chip-group="energy">
										<button type="button" class="chip" role="listitem" data-value="Low">Low</button>
										<button type="button" class="chip chip-active" role="listitem" data-value="Medium">Medium</button>
										<button type="button" class="chip" role="listitem" data-value="High">High</button>
									</div>
								</div>

								<div class="checkin-block">
									<div class="checkin-label">Sleep</div>
									<div class="chip-row" role="list" data-chip-group="sleep">
										<button type="button" class="chip" role="listitem" data-value="Good">Rested</button>
										<button type="button" class="chip chip-active" role="listitem" data-value="Fair">Normal</button>
										<button type="button" class="chip" role="listitem" data-value="Poor">Tired</button>
									</div>
								</div>
							</div>

							<div class="checkin-block">
								<div class="checkin-label">Stress</div>
								<div class="chip-row" role="list" data-chip-group="stress">
									<button type="button" class="chip" role="listitem" data-value="Low">Low</button>
									<button type="button" class="chip chip-active" role="listitem" data-value="Medium">Medium</button>
									<button type="button" class="chip" role="listitem" data-value="High">High</button>
								</div>
							</div>

							<div class="checkin-block">
								<div class="checkin-label">One sentence</div>
								<textarea class="diary-textarea" id="diaryText" rows="3" maxlength="500" placeholder="What’s on your mind today?"></textarea>
								<div class="helper-row">
									<span class="muted small">Examples: “I felt anxious before class.” “I’m proud I went for a walk.”</span>
									<span class="muted small" id="diaryCount">0/500</span>
								</div>
							</div>

							<div class="hero-actions">
								<button type="button" class="diary-btn diary-btn-primary" id="saveCheckinBtn">Save check-in</button>
								<button type="button" class="diary-btn diary-btn-ghost" id="addDetailsBtn">Add details</button>
							</div>
						</div>
					}

				@if (!hasTodayCheck)
				{
					<div class="card">
						<div class="card-head compact">
							<div>
								<h3>Guided prompts</h3>
								<p class="muted">Pick one to help you start writing.</p>
							</div>
						</div>

						<div class="prompt-grid">
							<button type="button" class="prompt-tile" data-prompt="Morning intention: What’s one thing I want to do with care today?">
								<div class="prompt-title">Morning intention</div>
								<div class="prompt-sub">Start your day with focus.</div>
							</button>
							<button type="button" class="prompt-tile" data-prompt="Evening reflection: What helped me feel even 1% better today?">
								<div class="prompt-title">Evening reflection</div>
								<div class="prompt-sub">Wind down and reset.</div>
							</button>
							<button type="button" class="prompt-tile" data-prompt="Gratitude: List 3 small things I’m grateful for today.">
								<div class="prompt-title">Gratitude</div>
								<div class="prompt-sub">Name 3 small things.</div>
							</button>
							<button type="button" class="prompt-tile" data-prompt="What challenged me? What did I need in that moment?">
								<div class="prompt-title">What challenged me?</div>
								<div class="prompt-sub">Notice patterns without judgment.</div>
							</button>
						</div>
					</div>
				}

				<div class="card">
					<div class="card-head compact">
						<div>
							<h3>Today’s focus</h3>
							<p class="muted">A simple goal and a tiny step.</p>
						</div>
					</div>

					<div class="focus-row">
						<div class="focus-item">
							<h1>NOT FUNCTIONAL. TO BE DONE.</h1>
							<div class="focus-label">Goal</div>
							<div class="focus-value" data-focus-goal>—</div>
						</div>
						<div class="focus-item">
							<div class="focus-label">Tiny step</div>
							<div class="focus-value" data-focus-step>—</div>
						</div>
					</div>

					<div class="hero-actions">
						<button type="button" class="diary-btn diary-btn-secondary" id="editFocusBtn">Edit</button>
						<button type="button" class="diary-btn diary-btn-ghost" id="markDoneBtn">Mark done</button>
					</div>
				</div>
			</section>

			<!-- RIGHT: Calendar + recent entries -->
			<aside class="diary-side" aria-label="Overview">
				<div class="card">
					<div class="card-head compact">
						<div>
							<h3>Calendar</h3>
							<p class="muted">Dates with journal entries and check-ins are highlighted.</p>
						</div>
					</div>

					<div class="mini-calendar" role="grid" aria-label="Mini calendar">
						<div class="mc-header">
							<button type="button" class="mc-nav" data-cal-prev aria-label="Previous month">‹</button>
							<div class="mc-month" data-month-label></div>
							<button type="button" class="mc-nav" data-cal-next aria-label="Next month">›</button>
						</div>
						<div class="mc-row mc-head" role="row">
							<span role="columnheader">M</span><span role="columnheader">T</span><span role="columnheader">W</span><span role="columnheader">T</span><span role="columnheader">F</span><span role="columnheader">S</span><span role="columnheader">S</span>
						</div>
						<div class="mc-body" data-calendar-body>
						</div>
						<div class="mc-legend">
							<div class="mc-legend-item">
								<span class="mc-legend-dot" style="background:#F9C74F"></span> Journal
							</div>
							<div class="mc-legend-item">
								<span class="mc-legend-dot" style="background:#90BE6D"></span> Check-in
							</div>
							<div class="mc-legend-item">
								<span class="mc-legend-dot" style="background:var(--color-primary)"></span> Both
							</div>
						</div>
					</div>
				</div>

				<div class="card">
					<div class="card-head compact">
						<div>
							<h3>Recent check-ins</h3>
							<p class="muted">A quick glance at how things have felt.</p>
						</div>
					</div>

					<div class="checkin-list">
						@if (Model?.CheckIns != null && Model.CheckIns.Any())
						{
							@foreach (var check in Model.CheckIns.Take(10))
							{
								<div class="checkin-item">
									<div>
										<div class="checkin-date">@check.CreatedOn.ToLocalTime().ToString("ddd · h:mm tt")</div>
										<div class="checkin-note">Mood: @check.Mood · Energy: @check.Energy · Sleep: @check.Sleep · Stress: @check.Stress</div>
										@if (!string.IsNullOrWhiteSpace(check.Notes))
										{
											<div class="checkin-note">@check.Notes</div>
										}
									</div>
									<span class="checkin-pill">Recent</span>
								</div>
							}
						}
						else
						{
							<p class="muted">No check-ins yet.</p>
						}
					</div>
				</div>

				<div class="card">
					<div class="card-head compact">
						<div>
							<h3>Recent journals</h3>
							<p class="muted">Your latest writing stays here.</p>
						</div>
					</div>

					<div class="entry-list" id="entryList">
						@if (Model?.Journals != null && Model.Journals.Any())
						{
							@foreach (var entry in Model.Journals)
							{
								<div class="entry-item">
									<div class="entry-meta">
										<span class="entry-date">@entry.CreatedOn.ToLocalTime().ToString("MMM dd")</span>
										<span class="entry-tag">@entry.Category</span>
									</div>
									<div class="entry-title">@entry.Title</div>
									<div class="entry-preview">@entry.Content</div>
								</div>
							}
						}
						else
						{
							<p class="muted">No entries yet.</p>
						}
					</div>

					<div class="side-actions">
						<button type="button" class="diary-btn diary-btn-secondary w-100" id="seeAllEntriesBtn">See all entries</button>
					</div>
				</div>

				</div>
			</aside>
		</div>
	</div>
</div>
<script src="~/js/myDiary.js" asp-append-version="true"></script>
