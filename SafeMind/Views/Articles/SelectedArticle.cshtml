@using SafeMind.Models
@model ArticlesViewModel

@{
    ViewData["Title"] = Model.Headline;
}

<link rel="stylesheet" href="~/css/articles.css" />
<link rel="stylesheet" href="~/css/selected-article.css" />

<!-- Hero banner with article image -->
<section class="article-hero">
    @if (!string.IsNullOrEmpty(Model.imagePath))
    {
        <div class="article-hero-bg" style="background-image:url('@Model.imagePath')">
            <div class="article-hero-overlay"></div>
        </div>
    }
    else
    {
        <div class="article-hero-bg article-hero-bg--plain">
            <div class="article-hero-overlay"></div>
        </div>
    }
    <div class="article-hero-content container">
        <div class="article-categories">
            @foreach (var cat in Model.Categories)
            {
                <span class="article-cat-badge">@cat.Name</span>
            }
        </div>
        <h1 class="article-hero-title">@Model.Headline</h1>
        <div class="article-meta-row">
            <span class="article-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg>
                @Model.AuthorName
            </span>
            <span class="article-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                @Model.DateOfPublish.ToString("MMMM d, yyyy")
            </span>
            <span class="article-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                @(Model.ViewCount >= 1000 ? $"{Model.ViewCount / 1000.0:0.#}k" : Model.ViewCount.ToString()) views
            </span>
            <span class="article-meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
                @Model.Likes likes
            </span>
        </div>
    </div>
</section>

<!-- Article body -->
<section class="container">
    <article class="article-body-layout">
        <div class="article-body-content">
            @foreach (var paragraph in Model.Content.Split(new[] { "\n\n", "\r\n\r\n" }, StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@paragraph.Trim()</p>
            }

            <div class="article-like-section">
                <button type="button" class="article-like-btn @(Model.HasLiked ? "article-like-btn--liked" : "")" 
                        id="likeBtn" data-article-id="@Model.Id" data-liked="@Model.HasLiked.ToString().ToLower()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="@(Model.HasLiked ? "currentColor" : "none")" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    <span id="likeText">@(Model.HasLiked ? "Liked" : "Like this article")</span>
                    <span class="article-like-count" id="likeCount">@Model.Likes</span>
                </button>
            </div>
        </div>

        <aside class="article-body-sidebar">
            <div class="article-sidebar-card">
                <h4>About the Author</h4>
                <p class="article-author-name">@Model.AuthorName</p>
                <p class="article-author-desc">Contributing writer at SafeMind, focused on mental health and wellness topics.</p>
            </div>

            <div class="article-sidebar-card">
                <h4>Article Stats</h4>
                <div class="article-stat-row">
                    <span>Total Views</span>
                    <strong>@Model.ViewCount.ToString("N0")</strong>
                </div>
                <div class="article-stat-row">
                    <span>This Week</span>
                    <strong>@Model.ViewsInLastWeek.ToString("N0")</strong>
                </div>
                <div class="article-stat-row">
                    <span>Likes</span>
                    <strong>@Model.Likes.ToString("N0")</strong>
                </div>
            </div>

            <div class="article-sidebar-card">
                <h4>Categories</h4>
                <div class="article-sidebar-tags">
                    @foreach (var cat in Model.Categories)
                    {
                        <span class="article-sidebar-tag">@cat.Name</span>
                    }
                </div>
            </div>

            <a class="article-back-link" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Back to Articles
            </a>
        </aside>
    </article>
</section>

@Html.AntiForgeryToken()

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('likeBtn');
        if (!btn) return;

        btn.addEventListener('click', async function () {
            const articleId = btn.dataset.articleId;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            btn.disabled = true;

            try {
                const res = await fetch(`/Articles/LikeArticle/${articleId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                });

                if (!res.ok) return;

                const data = await res.json();
                const liked = data.hasLiked;
                const likes = data.likes;

                btn.dataset.liked = liked;
                btn.classList.toggle('article-like-btn--liked', liked);

                const svg = btn.querySelector('svg path');
                if (svg) svg.setAttribute('fill', liked ? 'currentColor' : 'none');

                document.getElementById('likeText').textContent = liked ? 'Liked' : 'Like this article';
                document.getElementById('likeCount').textContent = likes;

                // Also update the sidebar stat
                const statLikes = document.querySelectorAll('.article-stat-row');
                statLikes.forEach(function (row) {
                    if (row.querySelector('span') && row.querySelector('span').textContent.trim() === 'Likes') {
                        row.querySelector('strong').textContent = likes.toLocaleString();
                    }
                });

                // Update hero meta likes
                const metaItems = document.querySelectorAll('.article-meta-item');
                metaItems.forEach(function (item) {
                    if (item.textContent.includes('likes')) {
                        const svg = item.querySelector('svg');
                        item.innerHTML = '';
                        item.appendChild(svg);
                        item.append(` ${likes >= 1000 ? (likes / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : likes} likes`);
                    }
                });
            } finally {
                btn.disabled = false;
            }
        });
    });
</script>