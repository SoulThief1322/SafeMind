@{
    ViewData["Title"] = "Articles";
}

<link rel="stylesheet" href="~/css/articles.css" />

<section class="hero-editorial" data-hero-rotator>
    <aside class="hero-side-nav">
        <a class="side-link active" href="#" data-hero-topic="Mind">Mind</a>
        <a class="side-link" href="#" data-hero-topic="Wellness">Wellness</a>
        <a class="side-link" href="#" data-hero-topic="Sleep">Sleep</a>
        <a class="side-link" href="#" data-hero-topic="Therapy">Therapy</a>
        <a class="side-link" href="#" data-hero-topic="Insights">Insights</a>
    </aside>

    <div class="hero-bg" style="background-image:url('/images/feat1.jpg')">
        <div class="hero-overlay"></div>
        <div class="hero-inner container">
            <span class="hero-eyebrow" data-hero-eyebrow>Expansive Exploration</span>
            <h1 class="hero-title" data-hero-title>Where Land and<br /> Water Lead Us</h1>
            <a href="#" class="hero-cta-text" data-hero-cta>Read Article</a>
        </div>

        <div class="hero-notice">
            <div class="container hero-notice-inner">
                <p class="hero-notice-text">
                    <strong data-hero-category>New</strong>
                    <span data-hero-summary>Guided grounding exercises now available.</span>
                    <a href="#" data-hero-link>Learn more</a>
                </p>
            </div>
        </div>

        <div class="hero-dots" data-hero-dots aria-label="Featured articles" role="tablist"></div>
    </div>
</section>

<section class="container">

    <!-- EDITORIAL BODY -->
    <section class="editorial-layout">

        <!-- LEFT -->
        <div class="left-side">
            <h2 class="section-title">Latest Posts</h2>

            <div class="latest-posts">
                <a class="story-card">
                    <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=450&fit=crop" alt="Calming techniques">
                    <div class="story-content">
                        <span class="story-tag">Mind</span>
                        <h3>Calming Techniques That Actually Work</h3>
                        <p>Practical steps you can try today.</p>
                    </div>
                </a>

                <a class="story-card">
                    <img src="https://images.unsplash.com/photo-1511295742362-92c96b1cf484?w=600&h=450&fit=crop" alt="Night routines">
                    <div class="story-content">
                        <span class="story-tag">Sleep</span>
                        <h3>Why Night Routines Matter</h3>
                        <p>Build habits that support rest.</p>
                    </div>
                </a>

                <a class="story-card">
                    <img src="https://images.unsplash.com/photo-1545389336-cf090694435e?w=600&h=450&fit=crop" alt="Meditation in nature">
                    <div class="story-content">
                        <span class="story-tag">Wellness</span>
                        <h3>Finding Peace in Nature Walks</h3>
                        <p>How outdoor mindfulness reduces anxiety.</p>
                    </div>
