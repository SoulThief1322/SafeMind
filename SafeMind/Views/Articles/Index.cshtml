@{
    ViewData["Title"] = "Articles";
}

<link rel="stylesheet" href="~/css/articles.css" />

<section class="container">

    <!-- CAROUSEL -->
    <div class="carousel carousel-editorial">
        <button class="carousel-btn prev">‹</button>

        <div class="carousel-track">
            <div class="carousel-slide">
                <img src="/images/feat1.jpg">
                <div class="meta">
                    <span class="article-tag">Mindfulness</span>
                    <h4>Quick Breathing Reset</h4>
                </div>
            </div>

            <div class="carousel-slide">
                <img src="/images/feat2.jpg">
                <div class="meta">
                    <span class="article-tag">Sleep</span>
                    <h4>Better Night Routines</h4>
                </div>
            </div>

            <div class="carousel-slide">
                <img src="/images/feat3.jpg">
                <div class="meta">
                    <span class="article-tag">Wellness</span>
                    <h4>Tiny Steps, Big Calm</h4>
                </div>
            </div>

            <div class="carousel-slide">
                <img src="/images/feat3.jpg">
                <div class="meta">
                    <span class="article-tag">Wellness</span>
                    <h4>Tiny Steps, Big Calm</h4>
                </div>
            </div>

            <div class="carousel-slide">
                <img src="/images/feat3.jpg">
                <div class="meta">
                    <span class="article-tag">Wellness</span>
                    <h4>Tiny Steps, Big Calm</h4>
                </div>
            </div>
        </div>

        <button class="carousel-btn next">›</button>
    </div>

    <!-- EDITORIAL BODY -->
    <section class="editorial-layout">

        <!-- LEFT -->
        <div>
            <h2 class="section-title">Latest Posts</h2>

            <div class="latest-posts">
                <a class="story-card">
                    <img src="/images/a1.jpg">
                    <div class="story-content">
                        <span class="story-tag">Mind</span>
                        <h3>Calming Techniques That Actually Work</h3>
                        <p>Practical steps you can try today.</p>
                    </div>
                </a>

                <a class="story-card">
                    <img src="/images/a2.jpg">
                    <div class="story-content">
                        <span class="story-tag">Sleep</span>
                        <h3>Why Night Routines Matter</h3>
                        <p>Build habits that support rest.</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- RIGHT -->
        <aside class="editorial-sidebar">

            <div class="sidebar-block">
                <h4>Follow Us</h4>
                <div class="social-grid">
                    <a>Facebook</a>
                    <a>Instagram</a>
                    <a>Twitter</a>
                    <a>YouTube</a>
                </div>
            </div>

            <div class="sidebar-block">
                <h4>Categories</h4>
                <div class="category-grid">
                    <a class="category-tile" style="background-image:url('/images/cat1.jpg')">
                        <span>Mind</span><em>20</em>
                    </a>
                    <a class="category-tile" style="background-image:url('/images/cat2.jpg')">
                        <span>Sleep</span><em>12</em>
                    </a>
                </div>
            </div>

            <div class="sidebar-block">
                <h4>Most viewed posts</h4>

                <div class="most-viewed-post">
                    <img src="/images/p1.jpg">
                    <div>
                        <h5>Evening Wind-Down Rituals</h5>
                        <span>1.2k views</span>
                    </div>
                </div>

                <div class="most-viewed-post">
                    <img src="/images/p2.jpg">
                    <div>
                        <h5>Small Steps Toward Calm</h5>
                        <span>980 views</span>
                    </div>
                </div>

                <div class="most-viewed-post">
                    <img src="/images/p3.jpg">
                    <div>
                        <h5>Breathing for Busy Minds</h5>
                        <span>860 views</span>
                    </div>
                </div>

            </div>

        </aside>
    </section>
</section>

<script src="~/js/articles.js"></script>
