@using SafeMind.Models;
@using System.Text.Json;
@model ArticlesAndCategoriesViewModel

<link rel="stylesheet" href="~/css/articles.css" />
<link rel="stylesheet" href="~/css/create-article.css" />

<script>
    window.__heroArticles = @Html.Raw(JsonSerializer.Serialize(
        Model.Articles.Take(5).Select(a => new {
            a.Id,
            a.Headline,
            Content = a.Content.Length > 100 ? a.Content.Substring(0, 100) + "..." : a.Content,
            Categories = a.Categories.Select(c => c.Name)
        }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
</script>

<section class="hero-editorial" data-hero-rotator>
    <aside class="hero-side-nav">
        @foreach (var feat in Model.Articles.Take(5))
        {
            <a class="side-link" href="#" data-hero-topic="@feat.Headline">@feat.Headline</a>
        }
    </aside>

    <div class="hero-bg" style="background-image:url('/images/feat1.jpg')">
        <div class="hero-overlay"></div>
        <div class="hero-inner container">
            <span class="hero-eyebrow" data-hero-eyebrow>Expansive Exploration</span>
            <h1 class="hero-title" data-hero-title>Where Land and<br /> Water Lead Us</h1>
            <a href="#" class="hero-cta-text" data-hero-cta>Read Article</a>
        </div>

        <div class="hero-notice">
            <div class="container hero-notice-inner">
                <p class="hero-notice-text">
                    <strong data-hero-category>New</strong>
                    <span data-hero-summary>Guided grounding exercises now available.</span>
                    <a href="#" data-hero-link>Learn more</a>
                </p>
            </div>
        </div>

        <div class="hero-dots" data-hero-dots aria-label="Featured articles" role="tablist"></div>
    </div>
</section>

<section class="container">

    @if (User.IsInRole("Admin"))
    {
        <div class="admin-toolbar">
            <a asp-action="Create" class="btn-new-article">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New Article
            </a>
        </div>
    }

    <!-- EDITORIAL BODY -->
    <section class="editorial-layout">

        <!-- LEFT -->
        <div class="left-side">
            <h2 class="section-title">Latest Posts</h2>

            <div class="latest-posts">
                @foreach (var article in Model.Articles)
                {
                    <div class="story-card-wrapper">
                        <a class="story-card" asp-action="SelectedArticle" asp-route-id="@article.Id">
                            @if (!string.IsNullOrEmpty(article.imagePath))
                            {
                                <img src="@article.imagePath" alt="@article.Headline">
                            }
                            <div class="story-content">
                                @if (article.Categories.Any())
                                {
                                    <span class="story-tag">@article.Categories.First().Name</span>
                                }
                                <h3>@article.Headline</h3>
                                <p>@(article.Content.Length > 80 ? article.Content.Substring(0, 80) + "..." : article.Content)</p>
                            </div>
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@article.Id" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this article?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete-article">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT -->
        <aside class="editorial-sidebar">

            <!-- Follow Us -->
            <div class="sidebar-block block-follow" role="region" aria-label="Follow Us">
                <h4>Follow Us</h4>
                <div class="social-grid">
                    <a class="social-btn social-facebook" href="#" aria-label="Facebook">
                        <span class="icon" aria-hidden="true">
                            <!-- Facebook SVG -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 5 3.657 9.128 8.438 9.878v-6.99H8.898v-2.888h1.54V9.413c0-1.523.903-2.366 2.288-2.366.663 0 1.356.118 1.356.118v1.492h-.764c-.752 0-.986.467-.986.946v1.134h1.68l-.268 2.888h-1.412v6.99C18.343 21.128 22 17 22 12z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>200k</strong>
                            <small>Like</small>
                        </div>
                    </a>

                    <a class="social-btn social-instagram" href="#" aria-label="Instagram">
                        <span class="icon" aria-hidden="true">
                            <!-- Instagram SVG -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 6.5a4 4 0 1 0 .001 8.001A4 4 0 0 0 12 8.5zm5.2-2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>200k</strong>
                            <small>Follower</small>
                        </div>
                    </a>

                    <a class="social-btn social-youtube" href="#" aria-label="YouTube">
                        <span class="icon" aria-hidden="true">
                            <!-- YouTube SVG -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23 7s-.2-1.4-.8-2c-.8-.8-1.7-.8-2.1-.9C16.5 4 12 4 12 4s-4.5 0-7.9.1c-.4 0-1.3.1-2.1.9C1.2 5.6 1 7 1 7S1 8.9 1 10.7v2.6C1 15.1 1.2 17 1.2 17s.2 1.4.8 2c.8.8 1.8.8 2.2.9C7.5 21 12 21 12 21s4.5 0 7.9-.1c.4 0 1.3-.1 2.1-.9.6-.6.8-2 .8-2s.2-1.9.2-3.7v-2.6C23 8.9 23 7 23 7zM10 15V9l5 3-5 3z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>120k</strong>
                            <small>Subscriber</small>
                        </div>
                    </a>

                    <a class="social-btn social-twitter" href="#" aria-label="Twitter">
                        <span class="icon" aria-hidden="true">
                            <!-- Twitter SVG -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23 4.56c-.8.36-1.7.6-2.6.71.94-.56 1.66-1.46 2-2.53-.88.53-1.85.9-2.88 1.1C18.9 2.9 17.7 2.5 16.4 2.5c-1.8 0-3.2 1.6-3.2 3.6 0 .28.03.55.1.8-2.66-.14-5.03-1.4-6.6-3.34-.28.5-.44 1.06-.44 1.67 0 1.14.6 2.16 1.5 2.75-.7 0-1.3-.2-1.9-.6v.06c0 1.7 1.2 3.14 2.8 3.46-.28.08-.56.12-.86.12-.2 0-.4 0-.6-.06.4 1.24 1.5 2.13 2.86 2.16C14.5 18.9 11 20 7.6 20c-.5 0-1-.03-1.4-.08 1.4.92 3.1 1.46 4.9 1.46 5.9 0 9.3-5 9.3-9.4v-.44c.7-.5 1.3-1.1 1.8-1.8-.6.3-1.3.5-2 .6.7-.5 1.2-1.1 1.6-1.9z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>200k</strong>
                            <small>Follower</small>
                        </div>
                    </a>

                    <a class="social-btn social-tiktok" href="#" aria-label="TikTok">
                        <span class="icon" aria-hidden="true">
                            <!-- TikTok SVG (simplified) -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 8v8a4 4 0 1 0 4-4V6h3a4 4 0 1 1-1.5 3.1V8h-4.5z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>120k</strong>
                            <small>Follower</small>
                        </div>
                    </a>

                    <a class="social-btn social-pinterest" href="#" aria-label="Pinterest">
                        <span class="icon" aria-hidden="true">
                            <!-- Pinterest SVG -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C7 2 4 5.1 4 8.9c0 2.3 1 4.3 2.9 5.1.3.1.5.1.7-.2l.6-2.2c-.2-.7-.4-1.8 0-2.6.4-1 2.1-1.7 3.5-1.1 1.8.6 2.7 2 2.7 4-.1 1.7-.8 3-1.5 4.2-.7 1.1.2 2 1.2 1.4 2.6-1.2 3.9-4.3 3.9-7.1C20 5 16 2 12 2z" fill="white"/></svg>
                        </span>
                        <div class="meta">
                            <strong>120k</strong>
                            <small>Subscriber</small>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Categories -->
            <div class="sidebar-block block-categories" role="navigation" aria-label="Categories">
                <h4>Categories</h4>
                <div class="category-grid">
                    @foreach (var category in Model.Categories)
                    {
                        <a class="category-tile category-tile--plain" href="#">
                            <span>@category</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Most viewed posts -->
            <div class="sidebar-block block-most-viewed" role="region" aria-label="Most viewed posts">
                <h4>Most viewed posts</h4>

                @foreach (var article in Model.Articles.OrderByDescending(a => a.ViewCount).Take(3))
                {
                    <a class="most-viewed-post" asp-action="SelectedArticle" asp-route-id="@article.Id">
                        @if (!string.IsNullOrEmpty(article.imagePath))
                        {
                            <img src="@article.imagePath" alt="@article.Headline">
                        }
                        <div>
                            <h5>@article.Headline</h5>
                            <span>@(article.ViewCount >= 1000 ? $"{article.ViewCount / 1000.0:0.#}k" : article.ViewCount.ToString()) views</span>
                        </div>
                    </a>
                }

            </div>

        </aside>
    </section>
</section>

<script src="~/js/articles.js"></script>
