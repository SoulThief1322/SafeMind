@page
@model RegisterDoctorModel
@{
	ViewData["Title"] = "Register Doctor";
}

<link rel="stylesheet" href="~/css/login-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/register-doctor.css" asp-append-version="true" />

<div class="page-login">
	<div class="page-login-card">
		<div class="page-login-logo">SM</div>
		<h1 class="page-login-title">Register as a Clinician</h1>
		<p class="page-login-lead">Join our network of mental health professionals</p>
		<div class="page-login-badge">Trusted &amp; secure</div>

		<form class="page-login-form" id="registerDoctor" method="post" asp-route-returnUrl="@Model.ReturnUrl">
			<div asp-validation-summary="ModelOnly" class="page-login-errors" role="alert"></div>

			<div class="page-login-field">
				<input asp-for="Input.FullName" aria-required="true" placeholder=" " />
				<label asp-for="Input.FullName">Full Name</label>
				<span asp-validation-for="Input.FullName" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.NationalId" aria-required="true" placeholder=" " />
				<label asp-for="Input.NationalId">National ID</label>
				<span asp-validation-for="Input.NationalId" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.DoctorId" aria-required="true" placeholder=" " />
				<label asp-for="Input.DoctorId">Medical License Number</label>
				<span asp-validation-for="Input.DoctorId" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder=" " />
				<label asp-for="Input.Email">Email address</label>
				<span asp-validation-for="Input.Email" class="text-danger"></span>
			</div>

			<div class="page-login-field page-login-field--stacked">
				<div class="field-heading">Specialties</div>
				<div class="field-subtitle">Select everything that appears on your license</div>
				<select asp-for="Input.SelectedSpecialties" multiple class="multi-select-control" size="6">
					@foreach (var specialty in Model.AvailableSpecialties)
					{
						<option value="@specialty">@specialty</option>
					}
				</select>
				<span asp-validation-for="Input.SelectedSpecialties" class="text-danger"></span>
				<small class="field-hint">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
			</div>

			<div class="page-login-field page-login-field--stacked">
				<div class="field-heading">Languages</div>
				<div class="field-subtitle">Clients will see these on your profile</div>
				<select asp-for="Input.SelectedLanguages" multiple class="multi-select-control" size="6">
					@foreach (var language in Model.AvailableLanguages)
					{
						<option value="@language">@language</option>
					}
				</select>
				<span asp-validation-for="Input.SelectedLanguages" class="text-danger"></span>
				<small class="field-hint">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
			</div>

			<div class="page-login-field time-field">
				<div class="field-heading">Workday start</div>
				<input asp-for="Input.WorkStart"           type="time"           lang="en-GB"           min="00:00"           max="23:59"           step="900"
					   class="time-input"           aria-required="true" />
				<small class="field-hint">24-hour format (00:00 – 23:59)</small>
			</div>

			<div class="page-login-field time-field">
				<div class="field-heading">Workday end</div>
				<input asp-for="Input.WorkEnd" type="time" lang="en-GB" min="00:00" max="23:59" step="900"
					   class="time-input" aria-required="true" />
				<small class="field-hint">24-hour format (00:00 – 23:59)</small>
			</div>
			<div class="page-login-field">
				<input asp-for="Input.SessionDuration" type="number" min="30" max="120" aria-required="true"
					   placeholder=" " />
				<label asp-for="Input.SessionDuration">Session Duration (minutes)</label>
				<span asp-validation-for="Input.SessionDuration" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder=" " />
				<label asp-for="Input.Password">Password</label>
				<span asp-validation-for="Input.Password" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true"
					   placeholder=" " />
				<label asp-for="Input.ConfirmPassword">Confirm password</label>
				<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
			</div>

			<button type="submit" class="page-login-button">Register</button>
		</form>

		<div class="page-login-footer">
			<span>Not a clinician?</span>
			<a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a
				user</a>
			</div>

			<div class="page-login-footer">
				<span>Already have an account?</span>
				<a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
			</div>
		</div>
	</div>

	<partial name="_ValidationScriptsPartial" />