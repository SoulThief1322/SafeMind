@page
@model LoginModel


<section class="container login-page">
  <div class="login-content" style="margin:48px auto; max-width:480px;">
    <div class="login-header">
      <div class="login-logo" aria-hidden="true"></div>
      <h2>Sign in to your account</h2>
      <p>If you prefer, you can also <a asp-area="Identity" asp-page="/Account/Register">create an account</a>.</p>
    </div>

    <form method="post" class="login-form">
      <div class="form-field">
        <input id="Input_Email" name="Input.Email" type="email" placeholder=" " required autocomplete="email" />
        <label for="Input_Email">Email address</label>
      </div>

      <div class="form-field">
        <input id="Input_Password" name="Input.Password" type="password" placeholder=" " required autocomplete="current-password" />
        <label for="Input_Password">Password</label>
      </div>

      <button type="submit" class="btn-login">Login</button>
    </form>

    <div class="login-separator"><span>OR</span></div>

    <div class="login-socials" aria-hidden="true">
      <button class="social-btn apple" aria-label="Login with Apple"></button>
      <button class="social-btn google" aria-label="Login with Google"></button>
      <button class="social-btn twitter" aria-label="Login with Twitter"></button>
    </div>
  </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
