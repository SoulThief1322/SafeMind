@page
@model LoginModel
@{
	ViewData["Title"] = "Log in";
}

<link rel="stylesheet" href="~/css/login-page.css" asp-append-version="true" />

@if (TempData["RegisterMessage"] != null)
{
	<div style="margin: 0 auto 24px auto; max-width: 400px; background: #e6f7ff; border: 1px solid #91d5ff; color: #005480; border-radius: 8px; padding: 16px 20px; font-size: 1.1em; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 12px;">
		<svg style="flex-shrink:0;" width="24" height="24" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#91d5ff"/><path d="M8 12.5l2.5 2.5 5-5" stroke="#005480" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
		<span>@TempData["RegisterMessage"]</span>
	</div>
}
@if (ViewData["EmailNotConfirmed"] != null)
{
	<div style="margin: 0 auto 24px auto; max-width: 400px; background: #fffbe6; border: 1px solid #ffe58f; color: #ad6800; border-radius: 8px; padding: 16px 20px; font-size: 1.1em; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 12px;">
		<svg style="flex-shrink:0;" width="22" height="22" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#ffe58f"/><path d="M12 8v4" stroke="#ad6800" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="#ad6800"/></svg>
		<span>@Html.Raw(ViewData["EmailNotConfirmed"])</span>
	</div>
}
<div class="page-login">
	<div class="page-login-card">
		<div class="page-login-logo">SM</div>
		<h1 class="page-login-title">Sign in</h1>
		<p class="page-login-lead">Stay on track-your sessions, notes, and progress all in one place.</p>
		<div class="page-login-badge">Trusted &amp; secure</div>

			<form class="page-login-form" id="account" method="post">
				<div asp-validation-summary="ModelOnly" class="page-login-errors" role="alert"></div>

				<div class="page-login-field">
				<input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder=" " />
				<label asp-for="Input.Email">Email address</label>
				<span asp-validation-for="Input.Email" class="text-danger"></span>
			</div>

			<div class="page-login-field">
				<input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder=" " />
				<label asp-for="Input.Password">Password</label>
				</div>

				<div class="page-login-meta">
					<a asp-page="./ForgotPassword">Forgot password?</a>
				</div>

				<button type="submit" class="page-login-button">Continue</button>
			</form>

			@if (Model.ExternalLogins?.Count > 0)
			{
				<div class="page-login-divider">
					<span>or</span>
				</div>
				<form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
					@foreach (var provider in Model.ExternalLogins)
					{
						<button type="submit" name="provider" value="@provider.Name" class="page-login-google-btn">
							<svg viewBox="0 0 24 24" width="20" height="20">
								<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z" fill="#4285F4"/>
								<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
								<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
								<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
							</svg>
							Continue with @provider.DisplayName
						</button>
					}
				</form>
			}

			<div class="page-login-footer">
				<span>New here?</span>
				<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
			</div>

			<div class="page-login-footer">
				<span>Are you a clinician?</span>
				<a asp-area="Identity" asp-page="/Account/RegisterDoctor" asp-route-returnUrl="@Model.ReturnUrl">Register as a doctor</a>
			</div>
	</div>
</div>

<partial name="_ValidationScriptsPartial" />
