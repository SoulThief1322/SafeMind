@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/login-page.css" asp-append-version="true" />

<div class="page-login">
    <div class="page-login-card">
        <div class="page-login-logo">SM</div>
        <h1 class="page-login-title">Create your account</h1>
        <p class="page-login-lead">Join SafeMind to capture every session, insight, and step forward.</p>
        <div class="page-login-badge">Trusted &amp; secure</div>

        <div style="margin-bottom: 18px; max-width: 500px; background: #fffbe6; border: 1px solid #ffe58f; color: #ad6800; border-radius: 8px; padding: 14px 18px; font-size: 1.08em; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 10px;">
            <svg style="flex-shrink:0;" width="22" height="22" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#ffe58f"/><path d="M12 8v4" stroke="#ad6800" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="#ad6800"/></svg>
            <span>After registering, you must confirm your email address before you can log in.</span>
        </div>
        <form class="page-login-form" id="register" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="page-login-errors" role="alert"></div>

            <div class="page-login-field">
                <input asp-for="Input.Username" aria-required="true" placeholder=" " />
                <label asp-for="Input.Username">Username</label>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="page-login-field">
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder=" " />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="page-login-field">
                <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder=" " />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="page-login-field">
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder=" " />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="page-login-button">Create account</button>
        </form>

        <div class="page-login-footer">
            <span>Already have an account?</span>
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
        </div>

        <div class="page-login-footer">
            <span>Are you a clinician?</span>
            <a asp-area="Identity" asp-page="/Account/RegisterDoctor" asp-route-returnUrl="@Model.ReturnUrl">Register as a doctor</a>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
