@page
@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/home.css">



<section class="hero">
    <div class="hero-text">
        <h1>Healing starts<br />with a single<br />step.</h1>

        <p>
            Take the first step toward feeling better.<br />
            Connect with someone who truly understands.
        </p>

        <a class="cta-btn" href="/Help">Get Help Now</a>
    </div>

    <div class="hero-images">
        <div class="img-box large"></div>
        <div class="img-box small"></div>
    </div>
</section>

<section class="about">
    <h2>About mental health</h2>

    <p>
        Mental health is about more than the absence of illness —
        it's how we think, feel, and cope with life's challenges.
        Taking care of your mind is just as important as caring for your body.
    </p>
</section>

<footer class="footer">
    <p>© 2025 MindCare. All rights reserved.</p>
</footer>